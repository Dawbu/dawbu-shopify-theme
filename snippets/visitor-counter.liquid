{% comment %}
  High-performance visitor counter with animated pulse dot
  Features:
  - Optimized JavaScript with minimal DOM manipulation
  - Hardware-accelerated CSS animations
  - Customizable colors, fonts, and update intervals
  - Mobile-responsive design
  - No external dependencies
{% endcomment %}

<style>
  .live_visitors {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding-left: 13px;
    color: {{ block.settings.counter_text_color | default: '#000000' }};
    font-family: {{ block.settings.counter_font_family | default: 'inherit' }};
    font-size: {{ block.settings.counter_font_size | default: 16 }}px;
    font-weight: 500;
    line-height: 1.4;
    margin: 0;
  }
  
  .live_visitors::before {
    position: absolute;
    display: inline-block;
    content: "";
    width: 8px;
    height: 8px;
    margin-left: -14px;
    top: 0.6em;
    border-radius: 100%;
    background: {{ block.settings.counter_dot_color | default: '#21b646' }};
    box-shadow: 0 0 0 0 {{ block.settings.counter_dot_color | default: '#21b646' }};
    animation: pulse-visitor 2s infinite;
    transform: translateZ(0); /* Hardware acceleration */
  }
  
  @keyframes pulse-visitor {
    0% {
      transform: scale(0.95) translateZ(0);
      box-shadow: 0 0 0 0 {{ block.settings.counter_dot_color | default: '#21b646' | color_modify: 'alpha', 0.7 }};
    }
    70% {
      transform: scale(1) translateZ(0);
      box-shadow: 0 0 0 10px {{ block.settings.counter_dot_color | default: '#21b646' | color_modify: 'alpha', 0 }};
    }
    100% {
      transform: scale(0.95) translateZ(0);
      box-shadow: 0 0 0 0 {{ block.settings.counter_dot_color | default: '#21b646' | color_modify: 'alpha', 0 }};
    }
  }

  /* Responsive adjustments */
  @media (max-width: 749px) {
    .live_visitors {
      font-size: {{ block.settings.counter_font_size | default: 16 | minus: 2 }}px;
      gap: 0.375rem;
    }
  }

  /* Reduced motion support */
  @media (prefers-reduced-motion: reduce) {
    .live_visitors::before {
      animation: none;
    }
  }

  /* High contrast mode support */
  @media (prefers-contrast: high) {
    .live_visitors::before {
      border: 1px solid currentColor;
    }
  }
</style>

<p class="live_visitors no-js-hidden" data-visitor-counter>
  <span id="visitors_count" aria-live="polite"></span> 
  {{ block.settings.counter_text | default: "People are viewing right now." }}
</p>

<script>
  // Performance-optimized visitor counter
  document.addEventListener('DOMContentLoaded', function() {
    const counterElement = document.getElementById('visitors_count');
    if (!counterElement) return;

    // Configuration
    const maxVisitors = {{ block.settings.max_visitors | default: 600 }};
    const minVisitors = {{ block.settings.min_visitors | default: 500 }};
    const updateDelay = {{ block.settings.update_delay | default: 4000 }};
    
    // Generate random visitor count
    function generateVisitorCount() {
      return Math.floor(Math.random() * (maxVisitors - minVisitors + 1)) + minVisitors;
    }
    
    // Update counter with smooth transition
    function updateCounter() {
      const newCount = generateVisitorCount();
      const currentCount = parseInt(counterElement.textContent) || minVisitors;
      
      // Smooth number transition
      if (newCount !== currentCount) {
        const increment = newCount > currentCount ? 1 : -1;
        let current = currentCount;
        
        const animateCount = () => {
          current += increment;
          counterElement.textContent = current;
          
          if (current !== newCount) {
            requestAnimationFrame(animateCount);
          }
        };
        
        requestAnimationFrame(animateCount);
      }
    }
    
    // Initialize counter
    counterElement.textContent = generateVisitorCount();
    
    // Set up interval for updates
    const intervalId = setInterval(updateCounter, updateDelay);
    
    // Cleanup on page unload
    window.addEventListener('beforeunload', () => {
      clearInterval(intervalId);
    });
    
    // Pause updates when page is not visible (performance optimization)
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) {
        clearInterval(intervalId);
      } else {
        const newIntervalId = setInterval(updateCounter, updateDelay);
        // Store new interval ID for cleanup
        window.visitorCounterInterval = newIntervalId;
      }
    });
  });
</script>
