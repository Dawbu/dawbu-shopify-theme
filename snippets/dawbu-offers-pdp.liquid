{%- liquid
  assign heading = heading | default: 'Available Offers'
  assign offer_1 = offer_1 | default: 'Get Rs. 100 off'
  assign offer_1_tagline = offer_1_tagline | default: 'On carts above Rs. 899'
  assign offer_1_code = offer_1_code | default: 'SAVE100'
  assign offer_2 = offer_2 | default: 'Get 9% off'
  assign offer_2_tagline = offer_2_tagline | default: 'On carts above Rs. 1200'
  assign offer_2_code = offer_2_code | default: 'SAVE09'
  assign offer_3 = offer_3 | default: 'Get 15% off'
  assign offer_3_tagline = offer_3_tagline | default: 'On carts above Rs. 2400'
  assign offer_3_code = offer_3_code | default: 'SAVE15'
-%}
<div class="dawbu-offer-container">
  <div class="dawbu-offer-title">{{ heading }}</div>
  <div class="dawbu-offer-cblokwrap">
    <div class="dawbu-offer-block">
      <div class="dawbu-offer-header">
