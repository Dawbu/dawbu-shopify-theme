          </svg>
        </div>
      </div>
    </div>
    <div class="dawbu-offer-block">
      <div class="dawbu-offer-header">
        <div class="offleft">
          <span class="oftitle">{{ offer_3 }}</span>
          <span class="tag-lin">{{ offer_3_tagline }}</span>
        </div>
      </div>
      <div class="dawbu-offer-bottom">
        <p class="offer-text">Code: <span class="offer-code">{{ offer_3_code }}</span></p>
        <div class="copysvg" role="button" tabindex="0" aria-label="Copy code">
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M14.9993 6.66699H8.33268C7.89065 6.66699 7.46673 6.84259 7.15417 7.15515C6.84161 7.46771 6.66602 7.89163 6.66602 8.33366V15.0003C6.66602 15.4424 6.84161 15.8663 7.15417 16.1788C7.46673 16.4914 7.89065 16.667 8.33268 16.667H14.9993C15.4414 16.667 15.8653 16.4914 16.1779 16.1788C16.4904 15.8663 16.666 15.4424 16.666 15.0003V8.33366C16.666 7.89163 16.4904 7.46771 16.1779 7.15515C15.8653 6.84259 15.4414 6.66699 14.9993 6.66699Z" stroke="#121212" stroke-linecap="round" stroke-linejoin="round"/>
