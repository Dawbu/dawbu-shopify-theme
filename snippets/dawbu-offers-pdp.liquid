          </svg>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .dawbu-offer-container { margin: 0 0 24px; font-family: inherit; }
  .dawbu-offer-title {
    font-weight: 600;
    font-size: 15px;
    line-height: 1.4;
    letter-spacing: .02em;
    text-transform: uppercase;
    color: #121212;
    margin-bottom: 12px;
  }
  .dawbu-offer-cblokwrap {
    display: flex;
    align-items: stretch;
    justify-content: flex-start;
    gap: 10px;
    flex-wrap: wrap;
  }
  .dawbu-offer-block {
    flex: 1 1 220px;
    padding: 14px 16px;
    background: #f7f7f7;
    border: 1px solid #ebebeb;
    border-left: 3px solid #ed1c24;
    position: relative;
    border-radius: 0;
    min-width: 0;
  }
  .dawbu-offer-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 24px;
  }
  .dawbu-offer-block .offleft {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  .dawbu-offer-block .oftitle {
    color: #121212;
    font-weight: 700;
    font-size: 15px;
    line-height: 1.2;
  }
  .dawbu-offer-block .tag-lin {
    margin-top: 6px;
    font-weight: 400;
    font-size: 13px;
    line-height: 1.35;
    color: #555;
  }
  .dawbu-offer-bottom {
    display: flex;
    margin-top: 12px;
    padding-top: 10px;
    border-top: 1px dashed #c8c1bb;
    justify-content: space-between;
    align-items: center;
  }
  .dawbu-offer-bottom .copysvg {
    line-height: 1;
    cursor: pointer;
    position: relative;
  }
  .dawbu-offer-block p.offer-text {
    color: #121212;
    font-weight: 600;
    font-size: 13px;
    line-height: 1.2;
    margin: 0;
    letter-spacing: .02em;
  }
  .dawbu-offer-block .offer-code {
    color: #ed1c24;
    font-weight: 700;
    letter-spacing: .04em;
  }
  .dawbu-offer-copied {
    position: absolute;
    right: 24px;
    bottom: 6px;
    font-size: 11px;
    color: #ed1c24;
    font-weight: 700;
    pointer-events: none;
    animation: dawbu-offer-fade 1.6s ease;
  }
  @keyframes dawbu-offer-fade {
    0%   { opacity: 0; transform: translateY(4px); }
    15%  { opacity: 1; transform: translateY(0); }
    80%  { opacity: 1; transform: translateY(0); }
    100% { opacity: 0; transform: translateY(-4px); }
  }
  @media (max-width: 749px) {
    .dawbu-offer-cblokwrap {
      flex-wrap: nowrap;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      padding-bottom: 4px;
    }
    .dawbu-offer-block {
      flex: 0 0 78%;
      scroll-snap-align: start;
    }
    .dawbu-offer-title { font-size: 14px; }
    .dawbu-offer-block .oftitle { font-size: 14px; }
    .dawbu-offer-block .tag-lin { font-size: 11px; margin-top: 4px; }
    .dawbu-offer-block p.offer-text { font-size: 12px; }
    .dawbu-offer-bottom .copysvg svg { width: 16px; height: 16px; }
  }
</style>

<script>
  (function () {
    function init() {
      var btns = document.querySelectorAll('.dawbu-offer-block .copysvg');
      btns.forEach(function (btn) {
        if (btn.dataset.dawbuBound) return;
        btn.dataset.dawbuBound = '1';
        var copy = function () {
          var block = btn.closest('.dawbu-offer-block');
          if (!block) return;
          var codeEl = block.querySelector('.offer-code');
          if (!codeEl) return;
          var code = codeEl.innerText.trim();
          var done = function () {
            var msg = document.createElement('span');
            msg.className = 'dawbu-offer-copied';
            msg.innerText = 'Copied!';
            block.appendChild(msg);
            setTimeout(function () { msg.remove(); }, 1500);
          };
          if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(code).then(done).catch(function () {
              var ta = document.createElement('textarea');
              ta.value = code;
              document.body.appendChild(ta);
              ta.select();
              try { document.execCommand('copy'); done(); } catch (e) {}
              document.body.removeChild(ta);
            });
          } else {
            var ta = document.createElement('textarea');
            ta.value = code;
            document.body.appendChild(ta);
            ta.select();
            try { document.execCommand('copy'); done(); } catch (e) {}
            document.body.removeChild(ta);
          }
        };
        btn.addEventListener('click', copy);
        btn.addEventListener('keydown', function (e) {
          if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); copy(); }
        });
      });
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  })();
</script>
