{%- comment -%}
  Snippet: dawbu-gift-wrap
  Movable PDP block — renders the "Add gift wrap for this product" checkbox.
  Submits with the product form via `form="<product_form_id>"`.
  Requires: block.settings.gift_wrap_product, product_form_id.
{%- endcomment -%}

{%- if block.settings.gift_wrap_product != blank -%}
  {%- assign gift_wrap_product = block.settings.gift_wrap_product -%}
  {%- assign gift_wrap_variant_id = gift_wrap_product.selected_or_first_available_variant.id -%}
  {%- if gift_wrap_variant_id != blank -%}
    <div class="product-form__gift-wrap" data-gift-wrap-variant-id="{{ gift_wrap_variant_id }}">
      {% style %}
        .product-form__gift-wrap {
          margin-top: 1.5rem;
          padding-top: 1.5rem;
          border-top: 1px solid rgba(var(--color-foreground), 0.1);
        }
        .gift-wrap-checkbox {
          display: flex;
          align-items: center;
          gap: 0.75rem;
          cursor: pointer;
          margin: 0;
        }
        .gift-wrap-checkbox input[type="checkbox"] {
          width: 18px;
          height: 18px;
          min-width: 18px;
          cursor: pointer;
          accent-color: rgb(var(--color-button));
          flex-shrink: 0;
        }
        .gift-wrap-checkbox span {
          font-size: 1.4rem;
          line-height: 1.5;
          color: rgb(var(--color-foreground));
        }
        @media screen and (max-width: 749px) {
          .gift-wrap-checkbox span { font-size: 1.3rem; }
        }
      {% endstyle %}
      <label class="gift-wrap-checkbox">
        <input
          type="checkbox"
          id="gift-wrap-checkbox-{{ section.id }}"
          class="gift-wrap-checkbox-input"
          data-gift-wrap-variant-id="{{ gift_wrap_variant_id }}"
          form="{{ product_form_id }}"
        >
        <span>{{ block.settings.label | default: 'Add gift wrap for this product' }}</span>
      </label>
    </div>
  {%- endif -%}
{%- endif -%}
