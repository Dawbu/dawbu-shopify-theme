<script>
// Fix Shiprocket text display issues
function fixShiprocketText() {
  // Wait for Shiprocket elements to load
  setTimeout(function() {
    const shiprocketElements = document.querySelectorAll('.shiprocket-headless, .sr-headless-checkout');
    
    shiprocketElements.forEach(function(element) {
      // Fix COD text
      const codElements = element.querySelectorAll('*');
      codElements.forEach(function(el) {
        if (el.textContent && el.textContent.toLowerCase().includes('cod') && !el.textContent.includes('Cash on Delivery')) {
          el.textContent = el.textContent.replace(/\bcod\b/gi, 'Cash on Delivery');
        }
        if (el.textContent && el.textContent.toLowerCase().includes('free') && !el.textContent.includes('Free Shipping')) {
          el.textContent = el.textContent.replace(/\bfree\b/gi, 'Free Shipping');
        }
        if (el.textContent && el.textContent.toLowerCase().includes('express') && !el.textContent.includes('Express Delivery')) {
          el.textContent = el.textContent.replace(/\bexpress\b/gi, 'Express Delivery');
        }
        if (el.textContent && el.textContent.toLowerCase().includes('express') && !el.textContent.includes('Express Delivery')) {
          el.textContent = el.textContent.replace(/\bexpress\b/gi, 'Express Delivery');
        }
      });
    });
  }, 1000);
  
  // Re-run after 3 seconds to catch dynamically loaded content
  setTimeout(function() {
    const shiprocketElements = document.querySelectorAll('.shiprocket-headless, .sr-headless-checkout');
    
    shiprocketElements.forEach(function(element) {
      const codElements = element.querySelectorAll('*');
      codElements.forEach(function(el) {
        if (el.textContent && el.textContent.toLowerCase().includes('cod') && !el.textContent.includes('Cash on Delivery')) {
          el.textContent = el.textContent.replace(/\bcod\b/gi, 'Cash on Delivery');
        }
        if (el.textContent && el.textContent.toLowerCase().includes('free') && !el.textContent.includes('Free Shipping')) {
          el.textContent = el.textContent.replace(/\bfree\b/gi, 'Free Shipping');
        }
      });
    });
  }, 3000);
}

// Run on page load
if (document.readyState === 'loading') {
  document.addEventListener('DOMContentLoaded', fixShiprocketText);
} else {
  fixShiprocketText();
}

// Also run when new content is added (for AJAX updates)
const observer = new MutationObserver(function(mutations) {
  mutations.forEach(function(mutation) {
    if (mutation.addedNodes.length > 0) {
      fixShiprocketText();
    }
  });
});

observer.observe(document.body, {
  childList: true,
  subtree: true
});
</script>