{%- comment -%}
  snippet: dawbu-byob-mini
  Mini BYOB builder for the PDP. If the current product belongs to a BYOB
  bundle collection, it picks the smallest matching pack (the cheapest tier)
  and lets the customer fill the slots in-place — slot 0 is pre-filled with the
  current product, Surprise Me fills the rest, and "Add bundle" posts all
  variants to /cart/add.js. No navigation away from the PDP.

  Requires: product, block.
{%- endcomment -%}

{%- if product == blank or product.id == blank -%}
{%- else -%}
  {%- assign pack_handles    = "build-craft-crate,mega-box,block-sets,master-builder-set,collectors-vault,glow-grab-bag,glow-mini-pack,glow-squad-bag,mini-starter-pack,mini-mates-pack,mini-figures,mini-heroes-pack,big-mini-figures,premium-minis" | split: "," -%}
  {%- assign pack_titles     = "Build & Craft Crate|10-in-1 Mega Box|Block Sets|Master Builder Set|Collector's Vault|Glow Grab Bag|Glow Mini Pack|Glow Squad Bag|Mini Starter Pack|Mini Mates Pack|Mini Figures|Mini Heroes Pack|Big Mini Figures|Premium Minis" | split: "|" -%}
  {%- assign pack_quantities = "6,6,6,6,6,25,14,11,9,7,6,6,6,6" | split: "," -%}
  {%- assign pack_prices     = "390,450,735,849,1419,199,199,209,210,199,199,220,279,310" | split: "," -%}
  {%- assign pack_collections= "byob-block-69,byob-block-79,byob-block-129,byob-block-149,byob-block-249,byob-mini-bulk,byob-mini-15,byob-mini-20,byob-mini-25,byob-mini-30,byob-mini-35,byob-mini-39,byob-mini-49,byob-mini-55" | split: "," -%}

  {%- assign pc_handles = ',' -%}
  {%- for c in product.collections -%}
    {%- assign pc_handles = pc_handles | append: c.handle | append: ',' -%}
  {%- endfor -%}

  {%- assign chosen_pi = -1 -%}
  {%- assign chosen_price = 9999999 -%}
  {%- for ph in pack_handles -%}
    {%- assign pi = forloop.index0 -%}
    {%- assign coll_handle = pack_collections[pi] -%}
    {%- assign needle = ',' | append: coll_handle | append: ',' -%}
    {%- if pc_handles contains needle -%}
      {%- assign p = pack_prices[pi] | plus: 0 -%}
      {%- if p < chosen_price -%}
        {%- assign chosen_price = p -%}
        {%- assign chosen_pi = pi -%}
      {%- endif -%}
    {%- endif -%}
  {%- endfor -%}

  {%- if chosen_pi >= 0 -%}
    {%- assign pk_handle = pack_handles[chosen_pi] -%}
    {%- assign pk_title  = pack_titles[chosen_pi] -%}
    {%- assign pk_qty    = pack_quantities[chosen_pi] | plus: 0 -%}
    {%- assign pk_price  = pack_prices[chosen_pi] | plus: 0 -%}
    {%- assign pk_coll   = collections[pack_collections[chosen_pi]] -%}
    {%- assign anchor_v  = product.selected_or_first_available_variant -%}

    <section class="dawbu-mini"
             data-mini-pack="{{ pk_handle }}"
             data-mini-coll="{{ pack_collections[chosen_pi] }}"
             data-mini-qty="{{ pk_qty }}"
             data-mini-price-cents="{{ pk_price | times: 100 }}"
             data-mini-anchor-id="{{ anchor_v.id }}"
             data-mini-anchor-title="{{ product.title | escape }}"
             data-mini-anchor-image="{{ product.featured_image | image_url: width: 200 }}"
             {{ block.shopify_attributes }}>

      <header class="dawbu-mini__head">
        <span class="dawbu-mini__eyebrow">{{ block.settings.eyebrow | default: 'Make it a bundle' }}</span>
        <h3 class="dawbu-mini__title">{{ pk_title }} · Any {{ pk_qty }} for Rs. {{ pk_price }}</h3>
      </header>

      <div class="dawbu-mini__slots" role="list" aria-label="Bundle slots">
        {%- for i in (1..pk_qty) -%}
          {%- assign idx = forloop.index0 -%}
          <div class="dawbu-mini__slot{% if idx == 0 %} is-anchor is-filled{% endif %}"
               data-slot="{{ idx }}"
               role="listitem">
            {%- if idx == 0 -%}
              <img class="dawbu-mini__slot-img" alt="{{ product.title | escape }}" src="{{ product.featured_image | image_url: width: 120 }}"/>
              <span class="dawbu-mini__slot-pin" aria-label="This product is locked in slot 1">★</span>
            {%- else -%}
              <span class="dawbu-mini__slot-plus" aria-hidden="true">+</span>
              <img class="dawbu-mini__slot-img" alt="" hidden/>
              <button type="button" class="dawbu-mini__slot-x" aria-label="Remove from slot" hidden>×</button>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>

      <div class="dawbu-mini__actions">
        <button type="button" class="dawbu-mini__surprise" data-mini-surprise>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="3"/><circle cx="8" cy="8" r="1.2" fill="currentColor"/><circle cx="16" cy="8" r="1.2" fill="currentColor"/><circle cx="12" cy="12" r="1.2" fill="currentColor"/><circle cx="8" cy="16" r="1.2" fill="currentColor"/><circle cx="16" cy="16" r="1.2" fill="currentColor"/></svg>
          <span>Surprise me</span>
        </button>
        <a class="dawbu-mini__choose" href="/pages/{{ pk_handle }}">Pick yourself →</a>
      </div>

      <div class="dawbu-mini__foot">
        <div class="dawbu-mini__price">
          <span class="dawbu-mini__price-label">Bundle price</span>
          <strong class="dawbu-mini__price-now">Rs. {{ pk_price }}</strong>
        </div>
        <button type="button" class="dawbu-mini__cta" data-mini-add disabled>
          <span class="dawbu-mini__cta-label">Add {{ pk_qty | minus: 1 }} more</span>
        </button>
      </div>

      {%- comment -%} Server-emitted product list for this pack so the JS can fill slots locally. {%- endcomment -%}
      <script type="application/json" class="dawbu-mini__pool">
        [
          {%- for sp in pk_coll.products -%}
            {%- assign sv = sp.selected_or_first_available_variant -%}
            {%- unless sv.available -%}{%- continue -%}{%- endunless -%}
            {"id":{{ sp.id }},"vid":{{ sv.id }},"t":{{ sp.title | json }},"img":"{{ sp.featured_image | image_url: width: 200 }}"}{%- unless forloop.last -%},{%- endunless -%}
          {%- endfor -%}
        ]
      </script>
    </section>

    <style>
      .dawbu-mini {
        --d-red: #e52227;
        --d-yellow: #faed17;
        --d-black: #040202;
        --d-cream: #fdf8ee;
        font-family: 'Poppins', system-ui, -apple-system, sans-serif;
        margin: 14px 0 18px;
        padding: 16px 16px 14px;
        background: var(--d-cream);
        border: 1px solid #ece2cc;
        border-radius: 16px;
      }
      .dawbu-mini__head {
        display: flex;
        flex-direction: column;
        gap: 4px;
        margin-bottom: 12px;
      }
      .dawbu-mini__eyebrow {
        font-size: 10.5px;
        font-weight: 800;
        letter-spacing: .2em;
        text-transform: uppercase;
        color: var(--d-red);
      }
      .dawbu-mini__title {
        margin: 0;
        font-size: 15px;
        font-weight: 800;
        line-height: 1.25;
        color: var(--d-black);
      }

      .dawbu-mini__slots {
        display: grid;
        grid-template-columns: repeat(6, 1fr);
        gap: 6px;
        margin-bottom: 12px;
      }
      @media (max-width: 560px) {
        .dawbu-mini__slots {
          grid-template-columns: repeat(5, 1fr);
          gap: 4px;
        }
      }
      .dawbu-mini__slot {
        position: relative;
        aspect-ratio: 1 / 1;
        background: #fff;
        border: 1.5px dashed #d6c69e;
        border-radius: 10px;
        display: grid;
        place-items: center;
        overflow: hidden;
        transition: border-color .2s ease, transform .25s cubic-bezier(.34,1.56,.64,1), background .2s ease;
      }
      .dawbu-mini__slot.is-filled {
        border-style: solid;
        border-color: var(--d-red);
        background: #fff;
      }
      .dawbu-mini__slot.is-anchor {
        border-color: var(--d-yellow);
        box-shadow: 0 0 0 2px var(--d-yellow) inset;
      }
      .dawbu-mini__slot.is-spinning .dawbu-mini__slot-img { filter: blur(2px); }
      .dawbu-mini__slot.pop { animation: dawbu-mini-pop .35s cubic-bezier(.34,1.56,.64,1); }
      @keyframes dawbu-mini-pop {
        0% { transform: scale(1); }
        50% { transform: scale(1.12); }
        100% { transform: scale(1); }
      }
      .dawbu-mini__slot-plus {
        font-size: 22px;
        font-weight: 300;
        color: #c4b48b;
        line-height: 1;
      }
      .dawbu-mini__slot-img {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
      }
      .dawbu-mini__slot.is-filled .dawbu-mini__slot-plus { display: none; }
      .dawbu-mini__slot-pin {
        position: absolute;
        top: 4px;
        right: 4px;
        z-index: 2;
        width: 16px;
        height: 16px;
        background: var(--d-yellow);
        color: var(--d-red);
        border-radius: 50%;
        display: grid;
        place-items: center;
        font-size: 9px;
        font-weight: 800;
        line-height: 1;
        box-shadow: 0 1px 4px rgba(0,0,0,.18);
      }
      .dawbu-mini__slot-x {
        position: absolute;
        top: 4px;
        right: 4px;
        z-index: 2;
        width: 18px;
        height: 18px;
        border: none;
        background: rgba(4,2,2,.78);
        color: #fff;
        border-radius: 50%;
        font-size: 12px;
        line-height: 1;
        cursor: pointer;
        padding: 0;
        font-family: inherit;
        backdrop-filter: blur(2px);
        box-shadow: 0 1px 4px rgba(0,0,0,.22);
      }
      .dawbu-mini__slot-x:hover { background: var(--d-black); }
      .dawbu-mini__slot.is-filled:not(.is-anchor) .dawbu-mini__slot-x { display: grid; place-items: center; }

      .dawbu-mini__actions {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
        margin-bottom: 12px;
        flex-wrap: wrap;
      }
      .dawbu-mini__surprise {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 9px 16px;
        background: var(--d-yellow);
        color: var(--d-black);
        border: 1.5px solid var(--d-black);
        border-radius: 999px;
        font-weight: 800;
        font-size: 12.5px;
        letter-spacing: .04em;
        text-transform: uppercase;
        cursor: pointer;
        font-family: inherit;
        transition: background .18s ease, color .18s ease, transform .12s ease, box-shadow .25s ease;
      }
      .dawbu-mini__surprise:hover:not(:disabled) {
        background: var(--d-red);
        color: #fff;
        border-color: var(--d-red);
      }
      .dawbu-mini__surprise:disabled { opacity: .6; cursor: not-allowed; }
      .dawbu-mini__surprise.is-rolling svg { animation: dawbu-mini-spin .6s linear infinite; }
      @keyframes dawbu-mini-spin { to { transform: rotate(360deg); } }

      .dawbu-mini__choose {
        font-size: 12.5px;
        font-weight: 700;
        color: var(--d-black);
        text-decoration: none;
        border-bottom: 1.5px solid var(--d-black);
        padding-bottom: 1px;
        transition: color .15s ease, border-color .15s ease;
      }
      .dawbu-mini__choose:hover { color: var(--d-red); border-color: var(--d-red); }

      .dawbu-mini__foot {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        padding-top: 12px;
        border-top: 1px dashed #e2d4b3;
      }
      .dawbu-mini__price { display: inline-flex; align-items: baseline; gap: 8px; }
      .dawbu-mini__price-label { font-size: 12px; font-weight: 600; color: #6b6258; }
      .dawbu-mini__price-now {
        font-size: 20px;
        font-weight: 900;
        color: var(--d-red);
        letter-spacing: -.012em;
        font-variant-numeric: tabular-nums;
      }
      .dawbu-mini__cta {
        background: var(--d-red);
        color: #fff;
        border: 2px solid var(--d-red);
        border-radius: 999px;
        padding: 11px 22px;
        font-weight: 800;
        font-size: 13px;
        letter-spacing: .04em;
        text-transform: uppercase;
        cursor: pointer;
        font-family: inherit;
        transition: background .18s ease, transform .12s ease, box-shadow .25s ease;
      }
      .dawbu-mini__cta:hover:not(:disabled) {
        background: #c41a1f;
        border-color: #c41a1f;
        box-shadow: 0 8px 20px rgba(229, 34, 39, .22);
      }
      .dawbu-mini__cta:disabled {
        background: #efb3b6;
        border-color: #efb3b6;
        cursor: not-allowed;
        box-shadow: none;
      }
      .dawbu-mini__cta.is-loading { pointer-events: none; opacity: .8; }
    </style>

    <script>
      (function () {
        var script = document.currentScript;
        var root = null;
        if (script) {
          var node = script.previousElementSibling;
          while (node) {
            if (node.classList && node.classList.contains('dawbu-mini')) { root = node; break; }
            node = node.previousElementSibling;
          }
          if (!root && script.parentElement) root = script.parentElement.querySelector('.dawbu-mini');
        }
        if (!root) root = document.querySelector('.dawbu-mini:not([data-mini-wired])');
        if (!root || !root.classList || !root.classList.contains('dawbu-mini')) return;
        if (root.dataset.miniWired) return;
        root.dataset.miniWired = '1';

        var QTY     = parseInt(root.dataset.miniQty, 10) || 0;
        var PRICE_C = parseInt(root.dataset.miniPriceCents, 10) || 0;
        var ANCHOR  = {
          variantId: root.dataset.miniAnchorId,
          title:     root.dataset.miniAnchorTitle,
          image:     root.dataset.miniAnchorImage
        };
        var PACK = root.dataset.miniPack;
        var COLL = root.dataset.miniColl || '';
        var FROM_PRODUCT_ID     = {{ product.id | json }};
        var FROM_PRODUCT_HANDLE = {{ product.handle | json }};

        function detectSource() {
          try {
            var stored = JSON.parse(sessionStorage.getItem('byob_source') || 'null');
            if (stored && stored.at && (Date.now() - stored.at) < 30 * 60 * 1000) return stored;
          } catch (_) {}
          try {
            var p = new URLSearchParams(location.search);
            var utm = p.get('utm_source'), ref = p.get('ref');
            if (utm || ref) return { source: 'campaign', utm_source: utm || '', utm_medium: p.get('utm_medium') || '', utm_campaign: p.get('utm_campaign') || '', ref: ref || '', at: Date.now() };
          } catch (_) {}
          try {
            if (document.referrer) {
              var r = new URL(document.referrer);
              if (r.host !== location.host) {
                if (/instagram|facebook|fb\.|meta|t\.co|twitter|x\.com|threads|whatsapp/i.test(r.host)) return { source: 'social', host: r.host, at: Date.now() };
                if (/google|bing|duckduck|yahoo/i.test(r.host)) return { source: 'search', host: r.host, at: Date.now() };
                return { source: 'external', host: r.host, at: Date.now() };
              }
            }
          } catch (_) {}
          return { source: 'pdp_mini', product_id: FROM_PRODUCT_ID, product_handle: FROM_PRODUCT_HANDLE, at: Date.now() };
        }
        var SRC = detectSource();
        var FILL_METHOD = 'manual';

        function fireEvent(name, payload) {
          var detail = Object.assign({ surface: 'pdp_mini', pack_handle: PACK, anchor_product_id: FROM_PRODUCT_ID, anchor_product_handle: FROM_PRODUCT_HANDLE, source: SRC.source }, payload || {});
          try { document.dispatchEvent(new CustomEvent('byob:' + name, { detail: detail })); } catch (_) {}
          if (window.dataLayer && window.dataLayer.push) window.dataLayer.push(Object.assign({ event: 'byob_' + name }, detail));
        }
        fireEvent('mini_view', { qty_required: QTY, bundle_price: PRICE_C / 100, source_detail: SRC });

        var poolEl = root.querySelector('.dawbu-mini__pool');
        var POOL = [];
        try { POOL = JSON.parse(poolEl.textContent.trim()) || []; } catch (_) {}
        POOL = POOL.filter(function (p) { return String(p.vid) !== String(ANCHOR.variantId); });

        // Live fetch fallback — if the Liquid pool was empty (e.g. the pack collection
        // hadn't been indexed yet or has no products at render time), pull from the
        // Shopify collection JSON endpoint on demand.
        var poolReady = null;
        function ensurePool() {
          if (POOL.length) return Promise.resolve(POOL);
          if (poolReady) return poolReady;
          if (!COLL) return Promise.resolve([]);
          poolReady = fetch('/collections/' + COLL + '/products.json?limit=50')
            .then(function (r) { return r.ok ? r.json() : { products: [] }; })
            .then(function (data) {
              var products = (data && data.products) || [];
              POOL = products.filter(function (p) {
                return p.variants && p.variants[0] && p.variants[0].available;
              }).map(function (p) {
                var v = p.variants[0];
                var img = (p.images && p.images[0] && p.images[0].src) || '';
                return { id: p.id, vid: v.id, t: p.title, img: img };
              }).filter(function (p) { return String(p.vid) !== String(ANCHOR.variantId); });
              return POOL;
            })
            .catch(function () { return []; });
          return poolReady;
        }

        var slots = root.querySelectorAll('.dawbu-mini__slot');
        var cta   = root.querySelector('[data-mini-add]');
        var ctaLbl= cta.querySelector('.dawbu-mini__cta-label');
        var sur   = root.querySelector('[data-mini-surprise]');

        var picks = [{ variantId: ANCHOR.variantId, title: ANCHOR.title, image: ANCHOR.image }];

        function render() {
          slots.forEach(function (slot, i) {
            if (i === 0) return;
            var p = picks[i];
            var img = slot.querySelector('.dawbu-mini__slot-img');
            var x   = slot.querySelector('.dawbu-mini__slot-x');
            if (p) {
              img.src = p.image || '';
              img.hidden = false;
              if (x) x.hidden = false;
              slot.classList.add('is-filled');
            } else {
              img.removeAttribute('src');
              img.hidden = true;
              if (x) x.hidden = true;
              slot.classList.remove('is-filled');
            }
          });
          var remaining = QTY - picks.length;
          cta.disabled = remaining > 0;
          ctaLbl.textContent = remaining > 0 ? ('Add ' + remaining + ' more') : ('Add bundle to cart · Rs. ' + (PRICE_C / 100).toFixed(0));
        }
        render();

        root.addEventListener('click', function (e) {
          var x = e.target.closest('.dawbu-mini__slot-x');
          if (!x) return;
          var slot = x.closest('.dawbu-mini__slot');
          var idx = parseInt(slot.dataset.slot, 10);
          if (!idx) return;
          var removed = picks[idx];
          picks.splice(idx, 1);
          if (FILL_METHOD === 'surprise') FILL_METHOD = 'mixed';
          fireEvent('mini_slot_removed', { slot_index: idx, removed_variant_id: removed && removed.variantId, picks_remaining: picks.length, qty_required: QTY });
          render();
        });

        async function surpriseFill() {
          // Every tap re-rolls: clear all non-anchor picks first so the user can
          // hit Surprise Me as many times as they want and get fresh products.
          picks = picks.slice(0, 1);
          render();

          var need = QTY - picks.length;
          if (need <= 0) return;

          sur.disabled = true;
          sur.classList.add('is-rolling');

          // If Liquid emitted nothing, try the live fetch
          if (!POOL.length) await ensurePool();

          if (!POOL.length) {
            fireEvent('mini_surprise_empty_pool', { pool_size: 0, coll: COLL });
            sur.disabled = false;
            sur.classList.remove('is-rolling');
            return;
          }
          fireEvent('mini_surprise_click', { need: need, pool_size: POOL.length, picks_already: picks.length });

          // Fill all `need` slots — allow repeats when the pool is smaller than need
          var pool = POOL.slice();
          var finalPicks = [];
          for (var i = 0; i < need; i++) {
            if (!pool.length) pool = POOL.slice();           // re-fill bag → allows repeats
            var k = Math.floor(Math.random() * pool.length);
            finalPicks.push(pool[k]);
            pool.splice(k, 1);
          }

          var ticks = 0, maxTicks = 12, interval = 60;
          function spin() {
            if (ticks < maxTicks) {
              for (var s = picks.length; s < QTY; s++) {
                var rp = POOL[Math.floor(Math.random() * POOL.length)];
                var slot = slots[s]; if (!slot) continue;
                var img = slot.querySelector('.dawbu-mini__slot-img');
                if (img && rp) { img.src = rp.img || ''; img.hidden = false; }
                slot.classList.add('is-filled', 'is-spinning');
              }
              ticks++;
              setTimeout(spin, interval);
              return;
            }
            slots.forEach(function (s) { s.classList.remove('is-spinning'); });
            finalPicks.forEach(function (item) {
              picks.push({ variantId: item.vid, title: item.t, image: item.img });
              fireEvent('mini_slot_filled', { method: 'surprise', slot_index: picks.length - 1, variant_id: item.vid, product_id: item.id });
            });
            FILL_METHOD = FILL_METHOD === 'mixed' ? 'mixed' : 'surprise';
            for (var i2 = 1; i2 < picks.length; i2++) {
              var sEl = slots[i2];
              if (sEl) { sEl.classList.add('pop'); setTimeout((function (el) { return function () { el.classList.remove('pop'); }; })(sEl), 360); }
            }
            render();
            sur.disabled = false;
            sur.classList.remove('is-rolling');
          }
          setTimeout(spin, interval);
        }
        sur.addEventListener('click', surpriseFill);

        var choose = root.querySelector('.dawbu-mini__choose');
        if (choose) {
          choose.addEventListener('click', function () {
            try { sessionStorage.setItem('byob_source', JSON.stringify({ source: 'pdp_mini_pick', product_id: FROM_PRODUCT_ID, product_handle: FROM_PRODUCT_HANDLE, pack: PACK, at: Date.now() })); } catch (_) {}
            fireEvent('mini_pick_yourself_click', { pack_handle: PACK });
          });
        }

        cta.addEventListener('click', async function () {
          if (picks.length < QTY) return;
          cta.classList.add('is-loading');
          ctaLbl.textContent = 'Adding…';

          var ts = new Date().toISOString().slice(0, 19).replace('T', ' ');
          var baseProps = { _byob_pack: PACK, _byob_source: 'pdp_mini', _byob_origin: SRC.source, _byob_method: FILL_METHOD, _byob_from_product_id: String(FROM_PRODUCT_ID), _byob_from_product_handle: FROM_PRODUCT_HANDLE, _byob_at: ts };
          if (SRC.utm_source)    baseProps._byob_utm_source = SRC.utm_source;
          if (SRC.utm_medium)    baseProps._byob_utm_medium = SRC.utm_medium;
          if (SRC.utm_campaign)  baseProps._byob_utm_campaign = SRC.utm_campaign;
          if (SRC.ref)           baseProps._byob_ref = SRC.ref;
          if (SRC.host)          baseProps._byob_referrer_host = SRC.host;

          // Aggregate by variant ID so a repeated Surprise pick becomes quantity: 2
          // (cleaner than sending two separate lines for the same variant).
          var bucket = {};
          var order  = [];
          picks.forEach(function (p) {
            var vid = Number(p.variantId);
            if (bucket[vid] == null) { bucket[vid] = 0; order.push(vid); }
            bucket[vid] += 1;
          });
          var items = order.map(function (vid) {
            return { id: vid, quantity: bucket[vid], properties: baseProps };
          });
          fireEvent('bundle_added', { qty: QTY, bundle_price: PRICE_C / 100, method: FILL_METHOD, source_detail: SRC, items: items.map(function (i) { return { variant_id: i.id, quantity: i.quantity }; }), from_product_id: FROM_PRODUCT_ID, from_product_handle: FROM_PRODUCT_HANDLE });

          var cartEl = document.querySelector('cart-drawer') || document.querySelector('cart-notification');
          var sectionsParam = '';
          if (cartEl && typeof cartEl.getSectionsToRender === 'function') sectionsParam = cartEl.getSectionsToRender().map(function (s) { return s.id; }).join(',');

          try {
            var body = { items: items };
            if (sectionsParam) { body.sections = sectionsParam; body.sections_url = window.location.pathname; }
            var res = await fetch('/cart/add.js', { method: 'POST', headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' }, body: JSON.stringify(body) });
            if (!res.ok) throw new Error('cart-add ' + res.status);
            var added = await res.json();
            try { sessionStorage.removeItem('byob_source'); } catch (_) {}
            fireEvent('bundle_add_success', { qty: QTY, bundle_price: PRICE_C / 100, method: FILL_METHOD });

            ctaLbl.textContent = 'Added ✓';
            if (cartEl && typeof cartEl.renderContents === 'function' && added && added.sections) { try { cartEl.renderContents(added); return; } catch (_) {} }
            var icon = document.querySelector('#cart-icon-bubble, [data-cart-icon], .header__icon--cart');
            if (icon) { try { icon.click(); return; } catch (_) {} }
            window.location.href = '/cart';
          } catch (err) {
            fireEvent('bundle_add_error', { error: String(err && err.message || err), method: FILL_METHOD });
            ctaLbl.textContent = 'Try again';
            cta.classList.remove('is-loading');
            cta.disabled = false;
          }
        });
      })();
    </script>
  {%- endif -%}
{%- endif -%}
