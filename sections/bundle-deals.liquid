{% comment %}
  Section: Bundle Deals
  Pre-made fixed-price bundle showcase, styled to match the "Buy Entire
  Collection" (Fan Favourites) section: yellow badge + two-tone heading +
  product-card grid (mobile swiper) + an "Explore More Bundles" button.
  Theme editor → Add section → Bundle Deals.
  v2.0.0
{% endcomment %}

{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'fan-favourites.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign col = section.settings.collection
  assign limit = section.settings.products_to_show | default: 12
  assign btn_link = section.settings.button_link
  if btn_link == blank and col != blank
    assign btn_link = col.url
  endif
  if btn_link == blank
    assign btn_link = '/collections/all'
  endif
-%}

<section
  class="ff-section bundle-deals"
  id="section-{{ section.id }}"
  data-track-section="bundle_deals"
  style="--ff-bg: {{ section.settings.bg_color }}; --ff-pt: {{ section.settings.section_padding_top }}px; --ff-pb: {{ section.settings.section_padding_bottom }}px; --ff-cols: {{ section.settings.columns_desktop }};"
>
  <div class="ff-wrapper">
    <!-- Header -->
    <div class="ff-header">
      {%- if section.settings.badge_text != blank -%}
        <div class="ff-badge"><span>{{ section.settings.badge_text }}</span></div>
      {%- endif -%}
      <h2 class="ff-title">
        {{ section.settings.heading_black }}
        <span class="ff-title--red">{{ section.settings.heading_red }}</span>
      </h2>
    </div>

    <!-- Bundle grid -->
    <div class="ff-grids">
      <div class="ff-grid ff-grid--active" id="ff-grid-{{ section.id }}-0">
        {%- if col != blank and col.products.size > 0 -%}
          <div class="ff-swiper swiper">
            <div class="swiper-wrapper">
              {%- assign shown = 0 -%}
              {%- for product in col.products -%}
                {%- if shown >= limit -%}{%- break -%}{%- endif -%}
                {%- assign shown = shown | plus: 1 -%}
                <div class="swiper-slide">
                  {%- render 'card-product',
                    card_product: product,
                    media_aspect_ratio: 'square',
                    show_secondary_image: section.settings.show_secondary_image,
                    lazy_load: true,
                    quick_add: 'quantity',
                    section_id: section.id,
                    show_tags: false,
                    skip_styles: true
                  -%}
                </div>
              {%- endfor -%}
            </div>
          </div>
        {%- else -%}
          <p class="ff-empty">
            {%- if col == blank -%}
              Pick your <strong>bundles collection</strong> in the theme editor (Bundle Deals → Bundle).
            {%- else -%}
              The collection “{{ col.title }}” has no products yet.
            {%- endif -%}
          </p>
        {%- endif -%}
      </div>
    </div>

    <!-- Explore More Bundles -->
    <div class="ff-cta-wrap">
      <a class="ff-cta-btn" href="{{ btn_link }}">
        <span class="ff-cta-text">{{ section.settings.button_text }}</span>
      </a>
    </div>
  </div>
</section>

<script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
<script>
  (function () {
    var section = document.getElementById('section-{{ section.id }}');
    if (!section) return;
    var instances = [];
    function initSwipers() {
      var isMobile = window.innerWidth <= 749;
      if (isMobile) {
        section.querySelectorAll('.ff-swiper').forEach(function (el) {
          if (!el.classList.contains('swiper-initialized') && typeof Swiper !== 'undefined') {
            instances.push(new Swiper(el, { slidesPerView: 2.2, spaceBetween: 10 }));
          }
        });
      } else {
        instances.forEach(function (s) { s.destroy(true, true); });
        instances = [];
      }
    }
    function boot() {
      if (typeof Swiper === 'undefined') { setTimeout(boot, 80); return; }
      initSwipers();
    }
    boot();
    var t;
    window.addEventListener('resize', function () { clearTimeout(t); t = setTimeout(initSwipers, 150); });
  })();
</script>

{% schema %}
{
  "name": "Bundle Deals",
  "tag": "section",
  "class": "bundle-deals-wrapper",
  "settings": [
    { "type": "header", "content": "Heading" },
    { "type": "text", "id": "badge_text", "label": "Badge text", "default": "BEST VALUE PACKS" },
    { "type": "text", "id": "heading_black", "label": "Heading (dark part)", "default": "BUNDLE" },
    { "type": "text", "id": "heading_red", "label": "Heading (red part)", "default": "DEALS" },
    { "type": "header", "content": "Bundle" },
    { "type": "collection", "id": "collection", "label": "Bundles collection", "info": "A collection of your ready-made bundle products." },
    { "type": "range", "id": "products_to_show", "min": 4, "max": 24, "step": 2, "label": "Max bundles to show", "default": 12 },
    {
      "type": "select", "id": "columns_desktop", "label": "Columns on desktop",
      "options": [ { "value": "4", "label": "4" }, { "value": "5", "label": "5" }, { "value": "6", "label": "6" } ],
      "default": "5"
    },
    { "type": "checkbox", "id": "show_secondary_image", "label": "Show 2nd image on hover", "default": false },
    { "type": "header", "content": "Button" },
    { "type": "text", "id": "button_text", "label": "Button label", "default": "EXPLORE MORE BUNDLES" },
    { "type": "url", "id": "button_link", "label": "Button link", "info": "Leave blank to link to the bundles collection above." },
    { "type": "header", "content": "Section" },
    { "type": "color", "id": "bg_color", "label": "Background colour", "default": "#f2f0eb" },
    { "type": "range", "id": "section_padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Padding top", "default": 60 },
    { "type": "range", "id": "section_padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Padding bottom", "default": 60 }
  ],
  "presets": [
    { "name": "Bundle Deals" }
  ]
}
{% endschema %}
