{% comment %}
  Section: BYOB CTA
  Compact "Build Your Own" banner — no product picker. The whole banner (and
  its button) is a click action that redirects to the real builder page.
  Theme editor → Add section → BYOB CTA.
  v1.0.0
{% endcomment %}

{%- liquid
  assign link = section.settings.link | default: '/pages/byob-builder'
-%}

{%- style -%}
  #byc-{{ section.id }} {
    padding: {{ section.settings.padding_top }}px 16px {{ section.settings.padding_bottom }}px;
  }
  #byc-{{ section.id }} .byc-card {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    gap: 20px;
    background: linear-gradient(120deg, {{ section.settings.bg_1 }} 0%, {{ section.settings.bg_2 }} 100%);
    border: 2px solid {{ section.settings.border_color }};
    border-radius: 22px;
    padding: 22px 26px;
    text-decoration: none;
    color: {{ section.settings.text_color }};
    box-shadow: 0 10px 26px rgba(0,0,0,.08);
    transition: transform .18s ease, box-shadow .18s ease;
  }
  #byc-{{ section.id }} .byc-card:hover { transform: translateY(-3px); box-shadow: 0 18px 38px rgba(0,0,0,.14); }
  #byc-{{ section.id }} .byc-emoji { font-size: 40px; line-height: 1; flex: 0 0 auto; }
  #byc-{{ section.id }} .byc-body { flex: 1 1 auto; min-width: 0; }
  #byc-{{ section.id }} .byc-title { font-size: clamp(20px, 3vw, 28px); font-weight: 900; margin: 0 0 4px; letter-spacing: -0.01em; }
  #byc-{{ section.id }} .byc-sub { font-size: 14px; margin: 0; color: {{ section.settings.muted_color }}; }
  #byc-{{ section.id }} .byc-btn {
    flex: 0 0 auto;
    display: inline-flex; align-items: center; gap: 8px;
    background: {{ section.settings.btn_bg }}; color: {{ section.settings.btn_text }};
    font-weight: 800; font-size: 15px; padding: 13px 26px; border-radius: 50px; white-space: nowrap;
  }
  @media (max-width: 749px) {
    #byc-{{ section.id }} .byc-card { flex-direction: column; text-align: center; gap: 14px; padding: 22px; }
    #byc-{{ section.id }} .byc-btn { width: 100%; justify-content: center; }
  }
{%- endstyle -%}

<section id="byc-{{ section.id }}" class="byc-section" data-track-section="byob_cta">
  <a class="byc-card" href="{{ link }}" data-track-click="byob_cta_click">
    {%- if section.settings.emoji != blank -%}<span class="byc-emoji" aria-hidden="true">{{ section.settings.emoji }}</span>{%- endif -%}
    <span class="byc-body">
      <span class="byc-title">{{ section.settings.heading }}</span>
      {%- if section.settings.subheading != blank -%}<span class="byc-sub">{{ section.settings.subheading }}</span>{%- endif -%}
    </span>
    <span class="byc-btn">
      {{ section.settings.button_label }}
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </span>
  </a>
</section>

{% schema %}
{
  "name": "BYOB CTA",
  "tag": "section",
  "class": "section-byob-cta",
  "settings": [
    { "type": "text", "id": "emoji", "label": "Emoji / icon", "default": "🧩" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Build Your Own Collection" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Pick any 6 minis for ₹390 — mix & match your way." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "START BUILDING" },
    { "type": "url", "id": "link", "label": "Redirect to", "info": "The Build Your Own page, e.g. /pages/byob-builder." },
    { "type": "header", "content": "Colours" },
    { "type": "color", "id": "bg_1", "label": "Background start", "default": "#fff0f6" },
    { "type": "color", "id": "bg_2", "label": "Background end", "default": "#eaf2ff" },
    { "type": "color", "id": "border_color", "label": "Border", "default": "#ffd1e3" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#241c2e" },
    { "type": "color", "id": "muted_color", "label": "Subtext", "default": "#7c7587" },
    { "type": "color", "id": "btn_bg", "label": "Button background", "default": "#ff5c8a" },
    { "type": "color", "id": "btn_text", "label": "Button text", "default": "#ffffff" },
    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "max_width", "min": 700, "max": 1400, "step": 20, "unit": "px", "label": "Max width", "default": 1100 },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Padding top", "default": 24 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Padding bottom", "default": 24 }
  ],
  "presets": [
    { "name": "BYOB CTA" }
  ]
}
{% endschema %}
