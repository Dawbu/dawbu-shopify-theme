{% comment %}
  Section: Why Choose Us / Confidence
  File: sections/why-choose-us.liquid
{% endcomment %}

<section class="why-choose-us" data-track-section="why_choose_us" style="background-color: {{ section.settings.background_color }};">
  <div class="wcu-inner">
    {% if section.settings.badge_text != blank %}
      <div class="wcu-badge">{{ section.settings.badge_text }}</div>
    {% endif %}

    {% if section.settings.heading != blank %}
      <h2 class="wcu-heading" style="color: {{ section.settings.heading_color }};">
        {{ section.settings.heading }}
      </h2>
    {% endif %}

    {%- assign main_cards = section.blocks | where: 'type', 'main_card' -%}
    {% if main_cards.size > 0 %}
      <div class="wcu-cards">
        {% for block in main_cards %}
          <div
            class="wcu-card{% if block.settings.highlighted %} wcu-card--highlighted{% endif %}"
            style="
              background-color: {{ block.settings.card_bg }};
              border-color: {{ block.settings.card_border }};
            "
            {{ block.shopify_attributes }}
          >
            {% if block.settings.icon != blank %}
              <div class="wcu-card__icon">
                <img
                  src="{{ block.settings.icon | img_url: '120x120' }}"
                  alt="{{ block.settings.title | escape }}"
                  width="80"
                  height="80"
                  loading="lazy"
                >
              </div>
            {% elsif block.settings.icon_emoji != blank %}
              <div class="wcu-card__icon wcu-card__icon--emoji">
                <span
                  class="wcu-icon-bg"
                  style="background-color:{{ block.settings.icon_bg }};border-radius:{{ block.settings.icon_radius }}px;"
                >
                  {{ block.settings.icon_emoji }}
                </span>
              </div>
            {% endif %}

            <h3 class="wcu-card__title" style="color: {{ block.settings.title_color }};">
              {{ block.settings.title }}
            </h3>

            {% if block.settings.description != blank %}
              <p class="wcu-card__desc" style="color: {{ block.settings.desc_color }};">
                {{ block.settings.description }}
              </p>
            {% endif %}
          </div>
        {% endfor %}
      </div>
    {% endif %}

    {%- assign badge_items = section.blocks | where: 'type', 'badge_item' -%}
    {% if badge_items.size > 0 %}
      <div class="wcu-badges">
        {% for block in badge_items %}
          <div class="wcu-badge-item" {{ block.shopify_attributes }}>
            {% if block.settings.badge_icon != blank %}
              <img
                src="{{ block.settings.badge_icon | img_url: '80x80' }}"
                alt="{{ block.settings.badge_label | escape }}"
                width="40"
                height="40"
                loading="lazy"
              >
            {% elsif block.settings.badge_emoji != blank %}
              <span class="wcu-badge-item__emoji">{{ block.settings.badge_emoji }}</span>
            {% endif %}
            <span class="wcu-badge-item__label">{{ block.settings.badge_label }}</span>
          </div>
        {% endfor %}
      </div>
    {% endif %}
  </div>
</section>

<style>
          /* ── Section wrapper ── */
          .why-choose-us {
            padding: {{ section.settings.padding_top }}px 20px {{ section.settings.padding_bottom }}px;
            font-family: 'Helvetica Neue', Arial, sans-serif;
          }

          .wcu-inner {
            max-width: 1340px;
            margin: 0 auto;
          }

          /* ── Badge pill ── */
          .wcu-badge {
            background: {{ section.settings.badge_bg }};
            color: {{ section.settings.badge_text_color }};
            display: inline-block;
            font-size: 14px;
            font-weight: 700;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            padding: 6px 16px;
            border-radius: 50px;
            margin-bottom: 20px;
            border: 1px solid #040202;
            box-shadow: 4px 4px 0 0 #040202;
          }

          /* ── Heading ── */
          .wcu-heading {
            font-size: clamp(40px, 7vw, 74px);
            font-weight: 400;
            font-family: 'Kopiku';
            line-height: 1;
            letter-spacing: -0.02em;
            text-transform: uppercase;
            margin: 0 0 26px;
          }

          /* ── Main cards grid ── */
          .wcu-cards {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 32px;
            margin-bottom: 30px;
          }

          .wcu-card {
            border-radius: 20px;
            border: 3px solid transparent;
            padding: 36px 32px 40px;
            display: flex;
            flex-direction: column;
            gap: 20px;
            transition: transform 0.2s ease;
          }

          .wcu-card:hover {
            transform: translateY(-4px);
          }

          .wcu-card--highlighted {
            border-width: 3px;
          }

          /* ── Card icon ── */
          .wcu-card__icon {
            width: 70px;
            height: 70px;
          }

          .wcu-card__icon img {
            width: 70px;
            height: 70px;
            object-fit: contain;
          }

          .wcu-card__icon--emoji {
            display: flex;
            align-items: center;
            justify-content: center;
          }

          .wcu-icon-bg {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 70px;
            height: 70px;
            font-size: 36px;
            line-height: 1;
          }

          /* ── Card text ── */
          .wcu-card__title {
            font-size: clamp(18px, 2vw, 20px);
            font-weight: 600;
            font-family: 'Poppins';
            line-height: 1.2;
            margin: 0;
          }

          .wcu-card__desc {
            font-size: 16px;
            line-height: 1.6;
            margin: 0;
            opacity: 0.85;
            font-family: 'Poppins';
          }

          /* ── Bottom badge strip ── */
          .wcu-badges {
            display: grid;
            grid-template-columns: repeat(6, 1fr);
            gap: 20px;
          }

          .wcu-badge-item {
            background: {{ section.settings.badge_item_bg }};
            border: 1px solid {{ section.settings.badge_item_border }};
            border-radius: 14px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 10px;
            padding: 20px;
          }

          .wcu-badge-item img,
          .wcu-badge-item__emoji {
            font-size: 30px;
            line-height: 1;
          }

          .wcu-badge-item__label {
            font-size: 12px;
            font-weight: 700;
            letter-spacing: 0.06em;
            text-transform: uppercase;
            text-align: center;
            font-family: 'Poppins';
            color: {{ section.settings.badge_item_label_color }};
          }

          /* ── Responsive ── */
          @media (max-width: 1199px) {
            .wcu-cards {
              gap: 20px;
            }
      .wcu-heading{font-size: 56px;}
            .wcu-badges {
              grid-template-columns: repeat(3, 1fr);
            }
          }

          @media (max-width: 991px) {
      .wcu-heading{font-size: 42px;}
  .wcu-cards, .wcu-badges {
      gap: 15px;
  }
    .wcu-card {
        padding: 25px 20px;
    }

    .wcu-card--highlighted {border-width: 2px;}

    .wcu-icon-bg {
        width: 56px;
        height: 56px;
        border-radius: 12px !important;
        font-size: 28px;
    }

    .wcu-card__icon {
        width: max-content;
        height: auto;
    }

    .wcu-card__title {font-size: 16px;}

    .wcu-card__desc {
        font-size: 14px;
    }
          }
          @media (max-width: 749px) {
            .why-choose-us {
            padding: {{ section.settings.padding_top | times: 0.6 }}px 20px {{ section.settings.padding_bottom | times: 0.6 }}px;
          }
            .wcu-cards {
              grid-template-columns: 1fr;
            }
        .wcu-badge {
            font-size: 12px;
            line-height: 1.5;
            margin-bottom: 15px;
        }
            .wcu-badges {
              grid-template-columns: repeat(2, 1fr);
            }

            .wcu-card {
              padding: 24px 20px 28px;
            }
          }

          @media (max-width: 400px) {
            .wcu-badges {
              grid-template-columns: repeat(2, 1fr);
            }
          }
</style>

