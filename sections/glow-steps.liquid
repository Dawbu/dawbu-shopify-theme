{% comment %}
  Section: Glow Steps (How it works)
  Clean "how the product works" steps — light background, a heading, and
  numbered cards (green circle + bold lead-in + description). Defaults to the
  glow-miniature explainer. Theme editor → Add section → Glow Steps.
  v1.0.0
{% endcomment %}

{%- liquid
  assign steps = section.blocks | where: 'type', 'step'
-%}

{%- style -%}
  #gst-{{ section.id }} {
    background: {{ section.settings.bg_color }};
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    --gst-accent: {{ section.settings.accent_color }};
    --gst-heading: {{ section.settings.heading_color }};
    --gst-lead: {{ section.settings.lead_color }};
    --gst-text: {{ section.settings.text_color }};
    --gst-card-bg: {{ section.settings.card_bg }};
    --gst-card-border: {{ section.settings.card_border }};
    --gst-cols: {{ steps.size }};
  }
  #gst-{{ section.id }} .gst-inner { max-width: {{ section.settings.max_width }}px; margin: 0 auto; padding: 0 20px; }
  #gst-{{ section.id }} .gst-title {
    font-size: clamp(26px, 4vw, 40px);
    font-weight: 800;
    line-height: 1.1;
    margin: 0 0 24px;
    color: var(--gst-heading);
    letter-spacing: -0.01em;
  }
  #gst-{{ section.id }} .gst-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
  }
  #gst-{{ section.id }} .gst-card {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    background: var(--gst-card-bg);
    border: 1px solid var(--gst-card-border);
    border-radius: 16px;
    padding: 20px 22px;
    box-shadow: 0 4px 14px rgba(17,17,17,.04);
  }
  #gst-{{ section.id }} .gst-num {
    flex-shrink: 0;
    width: 34px; height: 34px;
    border-radius: 50%;
    background: var(--gst-accent);
    color: #fff;
    font-weight: 800; font-size: 15px;
    display: inline-flex; align-items: center; justify-content: center;
  }
  #gst-{{ section.id }} .gst-body { font-size: 15px; line-height: 1.6; color: var(--gst-text); margin: 3px 0 0; }
  #gst-{{ section.id }} .gst-lead { font-weight: 800; color: var(--gst-lead); }

  @media (min-width: 750px) {
    #gst-{{ section.id }} .gst-grid { grid-template-columns: repeat(var(--gst-cols), 1fr); gap: 20px; }
  }
{%- endstyle -%}

<section id="gst-{{ section.id }}" class="gst-section" data-track-section="glow_steps">
  <div class="gst-inner">
    {%- if section.settings.heading != blank -%}
      <h2 class="gst-title">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- if steps.size > 0 -%}
      <div class="gst-grid">
        {%- for block in steps -%}
          <div class="gst-card" {{ block.shopify_attributes }}>
            <span class="gst-num">{{ forloop.index }}</span>
            <p class="gst-body">
              {%- if block.settings.lead != blank -%}<span class="gst-lead">{{ block.settings.lead }}</span> {% endif -%}
              {{ block.settings.body }}
            </p>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Glow Steps",
  "tag": "section",
  "class": "section-glow-steps",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "How the glow works" },
    { "type": "header", "content": "Colours" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#fdf4e7" },
    { "type": "color", "id": "heading_color", "label": "Heading colour", "default": "#1b2545" },
    { "type": "color", "id": "accent_color", "label": "Number circle colour", "default": "#16a06a" },
    { "type": "color", "id": "lead_color", "label": "Lead-in text colour", "default": "#1b2545" },
    { "type": "color", "id": "text_color", "label": "Body text colour", "default": "#3a4256" },
    { "type": "color", "id": "card_bg", "label": "Card background", "default": "#ffffff" },
    { "type": "color", "id": "card_border", "label": "Card border", "default": "#efe7d6" },
    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "max_width", "min": 900, "max": 1600, "step": 20, "unit": "px", "label": "Max width", "default": 1200 },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Padding top", "default": 48 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Padding bottom", "default": 48 }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "text", "id": "lead", "label": "Bold lead-in", "default": "Charge it." },
        { "type": "textarea", "id": "body", "label": "Description", "default": "Leave the mini in light for 10–15 minutes — daylight or a lamp both work." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Glow Steps",
      "blocks": [
        { "type": "step", "settings": { "lead": "Charge it.", "body": "Leave the mini in light for 10–15 minutes — daylight or a lamp both work." } },
        { "type": "step", "settings": { "lead": "Lights off.", "body": "Switch off the room and watch it glow a soft green for hours." } },
        { "type": "step", "settings": { "lead": "Recharge anytime.", "body": "The glow is reusable forever — no batteries, no fuss." } }
      ]
    }
  ]
}
{% endschema %}
