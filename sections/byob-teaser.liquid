{% comment %}
  Section: BYOB Teaser
  The Build-Your-Own panel LOOK (badge, heading, empty slots, bundle price,
  green button) WITHOUT the product picker and without the red slot remove
  buttons. The green button redirects to the real builder page.
  Reuses byob.css so it matches the builder exactly.
  Theme editor → Add section → BYOB Teaser.
  v1.0.0
{% endcomment %}

{{ 'byob.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign N = section.settings.quantity | default: 6
  assign P = section.settings.price | default: 390
  assign link = section.settings.link | default: '/pages/byob-builder'
  assign slots_title = section.settings.slots_title | default: 'Add Any {N} Products In The Box'
  assign slots_title = slots_title | replace: '{N}', N | replace: '{P}', P
  assign lede = section.settings.lede | replace: '{N}', N | replace: '{P}', P
-%}

{%- style -%}
  #byt-{{ section.id }} { padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px; }
  #byt-{{ section.id }} .byob-build__title { cursor: default; }
  /* make the green button feel clickable (it is a link now) */
  #byt-{{ section.id }} a.byob-panel__cta { text-decoration: none; display: inline-flex; align-items: center; gap: 8px; }
{%- endstyle -%}

<div id="byt-{{ section.id }}">
  <div class="byob byob-build byob-build--v2">
    <div class="byob-build__head">
      {%- if section.settings.eyebrow != blank -%}
        <span class="byob-build__crumb">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      <h2 class="byob-build__title">{{ section.settings.heading }}</h2>
      {%- if lede != blank -%}
        <p class="byob-build__lede">{{ lede }}</p>
      {%- endif -%}
    </div>

    <section class="byob-panel">
      <div class="byob-panel__head">
        <h2 class="byob-panel__title">{{ slots_title }}</h2>
        <span class="byob-panel__chip"><span>0</span> OF {{ N }} PICKED</span>
      </div>

      <ol class="byob-panel__slots" role="list">
        {%- for i in (1..N) -%}
          <li class="byob-slot">
            <span class="byob-slot__plus" aria-hidden="true">+</span>
          </li>
        {%- endfor -%}
      </ol>

      <div class="byob-panel__cta-row">
        <div class="byob-panel__price">
          <span class="byob-panel__price-label">Bundle Price:</span>
          <strong class="byob-panel__price-now">Rs. {{ P }}.00</strong>
        </div>
        <a class="byob-panel__cta" href="{{ link }}" data-track-click="byob_teaser_cta">
          {{ section.settings.button_label }}
        </a>
      </div>
    </section>
  </div>
</div>

{% schema %}
{
  "name": "BYOB Teaser",
  "tag": "section",
  "class": "section-byob-teaser",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow / badge", "default": "BUILD YOUR OWN" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Build Your Own Collection" },
    { "type": "textarea", "id": "lede", "label": "Subheading", "info": "Use {N} for quantity and {P} for price.", "default": "Pick any {N} minis — pay just Rs. {P}. Mix and match whatever you love." },
    { "type": "text", "id": "slots_title", "label": "Slots heading", "default": "Add Any {N} Products In The Box", "info": "Use {N} for quantity, {P} for price." },
    { "type": "number", "id": "quantity", "label": "Quantity (number of slots)", "default": 6 },
    { "type": "number", "id": "price", "label": "Bundle price (Rs.)", "default": 390 },
    { "type": "header", "content": "Button" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Start Building" },
    { "type": "url", "id": "link", "label": "Redirect to", "info": "The Build Your Own page, e.g. /pages/byob-builder." },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Padding top", "default": 8 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Padding bottom", "default": 8 }
  ],
  "presets": [
    { "name": "BYOB Teaser" }
  ]
}
{% endschema %}
