   /*   #shopify-section-{{ section.id }} .hover\:meet-text-red-500:hover
    #shopify-section-{{ section.id }} .hover\:meet-text-sky-400:hover */
{% endstyle %}
<div class="meet-w-full meet-mx-auto meet-p-4 md:meet-p-8">
  <div class="meet-text-3xl meet-font-bold meet-text-gray-800 meet-mb-2 meet-text-center">
    {{ section.settings.title }}
  </div>
  <div class="meet-text-gray-600 meet-mb-8 meet-text-center">{{ section.settings.subtitle }}</div>

  <div class="meet-relative">
    <div
      id="carousel-{{ section.id }}"
      class="meet-flex meet-overflow-x-auto meet-space-x-4  meet-no-scrollbar meet-scroll-smooth"
    >
      <div class="swiper-wrapper" id="swiper-wrapper-{{ section.id }}"></div>
    </div>

    <button
      id="prevBtn-{{ section.id }}"
      class="prevBtn-{{ section.id }} meet-absolute meet-top-1/2 meet-left-2 meet-transform -meet-translate-y-1/2 meet-bg-slide-btn meet-backdrop-blur-sm meet-p-2 meet-text-gray-800 meet-shadow-lg hover:meet-bg-white meet-transition meet-duration-300 meet-z-10"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="meet-bg-slide-btn-svg"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
      >
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
      </svg>
    </button>
    <button
      id="nextBtn-{{ section.id }}"
      class="nextBtn-{{ section.id }} meet-absolute meet-top-1/2 meet-right-2 meet-transform -meet-translate-y-1/2 meet-bg-slide-btn meet-backdrop-blur-sm meet-p-2 meet-text-gray-800 meet-shadow-lg hover:meet-bg-white meet-transition meet-duration-300 meet-z-10"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="meet-bg-slide-btn-svg"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
      >
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
      </svg>
    </button>
  </div>
</div>
<!-- Swiper JS -->
<script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>

<script>
  
        const products = [
          
        {% for block in section.blocks %}
            {% assign product = block.settings.product %}
            {% assign compare_price = product.variants.first.compare_at_price %}
            {% assign current_price = product.variants.first.price %}

            {% if compare_price > current_price and compare_price > 0 %}
                {% assign discount = compare_price | minus: current_price %}
                {% assign discount_percentage = discount | times: 100 | divided_by: compare_price %}
            {% else %}
                {% assign discount_percentage = 0 %}
            {% endif %}

            {
              "title": "{% if product.title != blank %}{{ product.title | escape }}{% else %} Product Name {% endif %}",
              "id": "{% if product.id != blank %}{{ product.id }}{% else %} Product ID {% endif %}",
              "handle": "{% if product.handle != blank %}{{ product.handle }}{% else %} Product Handle {% endif %}",
              "url": "{% if product.url != blank %}{{ product.url }}{% else %} Product URL {% endif %}",
              "image": "{% if product.images.first.src != blank %}{{ product.images.first.src | image_url }}{% else %} https://cdn.shopify.com/s/files/1/0533/2089/files/placeholder-images-image_large.png?v=1530129081 {% endif %}",
              "variant_id": "{% if product.variants.first.id != blank %}{{ product.variants.first.id }}{% else %} 12345678 {% endif %}",
              "available": "{% if product.variants.first.available != blank %}{{ product.variants.first.available }}{% else %} false {% endif %}",
              "title": "{% if product.title != blank %}{{ product.title }} {{ product.variants.first.title }}{% else %} Product Title {% endif %}",
              "compare_at_price": "{% if compare_price != blank %}{{ compare_price | money_with_currency }}{% else %}{{ '999' | money_with_currency }} {% endif %}",
              "price": "{% if current_price != blank %}{{ current_price | money_with_currency }}{% else %} {{ '99' | money_with_currency }} {% endif %}",
              "discount_percentage": "{% if discount_percentage != blank %}{{ discount_percentage }}{% else %} 90 {% endif %}",
              "like_url": "{% if block.settings.like_url != blank %}{{ block.settings.like_url }}{% else %} # {% endif %}",
              "share_url": "{% if block.settings.share_url != blank %}{{ block.settings.share_url }}{% else %}# {% endif %}",
          },
        {% endfor %}       
    ];


        
        const videos = [
        {% for block in section.blocks %}
           {% if block.settings.video_source == 'youtube' %}
            {
            videoSrc:"{{ block.settings.youtube_url }}",
            videoType:"youtube"
            },
           {% elsif block.settings.video_source == 'shopify' %}
            {
            videoSrc:"{{ block.settings.shopify_video }}",
            videoType:"shopify"
            },  
           {% endif %}
        {% endfor %}

        ]   
       

        // Merge products + videos into one array
        const combinedData = products.map((product, index) => {
            return {
                ...product,
                ...(videos[index] || {})
            };
        });
        


        
        function getYoutubeEmbedUrl(url) {
            let videoId;
            try {
                const urlObj = new URL(url);
                if (urlObj.hostname.includes('youtube.com') && urlObj.pathname.includes('/shorts/')) {
                    videoId = urlObj.pathname.split('/shorts/')[1];
                } else if (urlObj.hostname.includes('youtube.com') && urlObj.searchParams.has('v')) {
                    videoId = urlObj.searchParams.get('v');
                } else if (urlObj.hostname.includes('youtu.be')) {
                    videoId = urlObj.pathname.split('/')[1];
                } else {
                    return null;
                }
                // Added allow='autoplay' for better compatibility
                return `https://www.youtube.com/embed/${videoId}?autoplay=1&mute=1&loop=1&playlist=${videoId}&controls=0&playsinline=1&enablejsapi=1`;
            } catch (e) {
                return null;
            }
        }

        function generateProductCards() {
            carousel.innerHTML = '';
            combinedData.forEach((product, index) => {
                const discountPercentage = 20;
                const youtubeEmbedUrl = getYoutubeEmbedUrl(product.videoSrc);
                if(product.discount_percentage > 0){
                var discount_percentage1 = `<div class="meet-discount meet-absolute meet-top-3 meet-left-3 meet-bg-black meet-text-white meet-text-xs meet-font-semibold meet-px-3 meet-py-1 meet-rounded-full">${product.discount_percentage}% discount</div>` 
                var discount_percentage2 =`<p class="meet-product-discount meet-text-xs meet-font-semibold meet-text-green-600">${product.discount_percentage}%Off</p>`;
                }
                else{
                var discount_percentage1 = '';
                var discount_percentage2 ='';
                }      
                
                
                const videoPlayerHtml = youtubeEmbedUrl
                    ? `<iframe class="meet-w-full {{ section.settings.video_size }}  meet-object-cover pointer-events-none" src="${youtubeEmbedUrl}" frameborder="0" allow="autoplay; encrypted-media" allowfullscreen></iframe>`
                    : `<video class="meet-w-full {{ section.settings.video_size }} meet-object-cover" src="${product.videoSrc }" autoplay loop muted playsinline></video>`;

                const card = `
                    <div class="swiper-slide meet-whatch-and-buy-card meet-flex-none meet-w-72 meet-bg-white meet-rounded-xl meet-shadow-lg meet-overflow-hidden meet-transform hover:-meet-translate-y-1 meet-transition-all meet-duration-300">
                        <div class="meet-relative ">
                        <div class="meet-video-container">
                        <div class="meet-video-player"> 
                           ${videoPlayerHtml}
                            <div class="meet-absolute meet-top-0 meet-left-0 meet-w-full  meet-video-overlay-gradient"></div>                
                         ${discount_percentage1}
                        
                            </div>
                        </div>
                            <div class="meet-absolute meet-bottom-3 meet-right-3 meet-flex  meet-items-center meet-space-y-3">
                                <a href="${product.like_url }" class="meeet-like-btn meet-background-transparent meet-text-white hover:meet-text-red-500 meet-transition-colors meet-duration-300"><svg xmlns="http://www.w3.org/2000/svg" class="meet-h-6 meet-w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 016.364 0L12 7.636l1.318-1.318a4.5 4.5 0 116.364 6.364L12 20.364l-7.682-7.682a4.5 4.5 0 010-6.364z" /></svg></a>
                                <a href="${product.share_url }"  class="meeet-share-btn meet-background-transparent  meet-text-white hover:meet-text-sky-400 meet-transition-colors meet-duration-300"><svg xmlns="http://www.w3.org/2000/svg" class="meet-h-6 meet-w-6 -meet-rotate-12" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" /></svg></a>
                            </div>
                        </div>
                        <div class="meet-p-4">
                            <div class="meet-flex meet-items-center meet-space-x-3">
                                <img src="${product.image}" alt="${product.title}" class="meet-w-12 meet-h-12 meet-rounded-full meet-object-cover meet-border-2 meet-border-gray-100 meet-product-image-round">
                                <div>
                                    <h3 class="meet-product-title meet-font-semibold meet-text-gray-800 meet-text-sm meet-truncate meet-w-48">${product.title}</h3>
                                    <div class="meet-product-price meet-flex meet-items-baseline meet-space-x-1.5 meet-mt-1"><p class="meet-font-bold meet-text-gray-900"> ${product.price}</p><p class="meet-text-xs meet-text-gray-400 meet-line-through"> ${product.compare_at_price}</p></div>
                                    ${discount_percentage2}
                                </div>
                            </div>
                            ${product.available 
                                ? `<a href="${ product.url }" class="meet-product-button meet-mt-3 meet-w-full meet-bg-gray-900 meet-text-white meet-py-2 meet-rounded-lg meet-font-semibold meet-text-sm hover:meet-bg-gray-800 meet-transition-colors meet-duration-300">Buy Now</a>`
                                : `<a href="#" class="meet-product-button meet-mt-3 meet-w-full meet-bg-gray-200 meet-text-gray-500 meet-py-2 meet-rounded-lg meet-font-semibold meet-text-sm meet-cursor-not-allowed">Out Of Stock</a>`
                            }
                        </div>
                    </div>
                `;
                carousel.innerHTML += card;
            });
        }
        
        generateProductCards();




// SLIDER

const swiper = new Swiper("#carousel-{{ section.id }}", {
      slidesPerView: {{ section.settings.slides_desktop }},   // 👈 shows 4 slides
      spaceBetween: 20,   // space between slides
      loop: true,
      pagination: {
        el: ".swiper-pagination",
        clickable: true,
      },
      navigation: {
        prevEl: "#prevBtn-{{ section.id }}",
        nextEl: "#nextBtn-{{ section.id }}",
      },
      breakpoints: {
        0: {        // mobile
          slidesPerView: {{ section.settings.slides_mobile }},
        },
        767: {      // small tablets
            slidesPerView: 3,
        },
        1250: {     // small tablets
          {% if section.settings.slides_desktop == "5" %}
            slidesPerView: 4,
          {% else %}
            slidesPerView: {{ section.settings.slides_desktop }},
          {% endif %}
        },
        1551: {      // small tablets
          slidesPerView: {{ section.settings.slides_desktop }},
        }
      }
    });

</script>

