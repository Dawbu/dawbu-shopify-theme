{% comment %}
  Section: Newsletter Offer (5% off) — compact horizontal bar
  Small one-line email capture with a 5% off reward. Uses Shopify's customer
  form. Create the actual code in Shopify Admin → Discounts (e.g. WELCOME5).
  Theme editor → Add section → Newsletter Offer.
  v2.0.0
{% endcomment %}

{%- style -%}
  #nlo-{{ section.id }} {
    background: linear-gradient(120deg, {{ section.settings.bg_top }} 0%, {{ section.settings.bg_bottom }} 100%);
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
  }
  #nlo-{{ section.id }} .nlo-bar {
    max-width: {{ section.settings.max_width }}px; margin: 0 auto; padding: 0 16px;
    display: flex; align-items: center; justify-content: center; gap: 12px 22px; flex-wrap: wrap;
  }
  #nlo-{{ section.id }} .nlo-headline {
    margin: 0; font-size: clamp(15px, 2vw, 20px); font-weight: 800; letter-spacing: -0.01em;
    color: {{ section.settings.headline_color }}; white-space: nowrap;
  }
  #nlo-{{ section.id }} .nlo-headline b { color: {{ section.settings.accent_color }}; }
  #nlo-{{ section.id }} .nlo-form { display: flex; gap: 8px; margin: 0; }
  #nlo-{{ section.id }} .nlo-input {
    height: 46px; min-width: 220px; max-width: 320px; flex: 1 1 220px;
    border: 1.5px solid {{ section.settings.input_border }}; border-radius: 50px; padding: 0 18px;
    font-size: 14px; background: #fff; color: {{ section.settings.input_text_color }};
  }
  #nlo-{{ section.id }} .nlo-input::placeholder { color: {{ section.settings.input_text_color }}; opacity: .55; }
  #nlo-{{ section.id }} .nlo-input:focus { outline: none; border-color: {{ section.settings.accent_color }}; }
  #nlo-{{ section.id }} .nlo-btn {
    height: 46px; border: 0; cursor: pointer; border-radius: 50px; white-space: nowrap;
    background: {{ section.settings.accent_color }}; color: {{ section.settings.accent_text_color }};
    font-weight: 800; font-size: 14px; padding: 0 22px; transition: transform .15s ease, filter .2s ease;
  }
  #nlo-{{ section.id }} .nlo-btn:hover { transform: translateY(-1px); filter: brightness(1.05); }
  #nlo-{{ section.id }} .nlo-success { margin: 0; font-size: 15px; font-weight: 700; color: {{ section.settings.headline_color }}; }
  #nlo-{{ section.id }} .nlo-success b {
    color: {{ section.settings.accent_color }}; letter-spacing: 1px;
    background: #fff; border-radius: 8px; padding: 3px 12px; margin-left: 6px;
  }
  #nlo-{{ section.id }} .nlo-error { width: 100%; text-align: center; color: #c0392b; font-size: 13px; margin: 6px 0 0; }

  @media (max-width: 599px) {
    #nlo-{{ section.id }} .nlo-form { width: 100%; }
    #nlo-{{ section.id }} .nlo-input { flex: 1 1 auto; max-width: none; }
  }
{%- endstyle -%}

<section id="nlo-{{ section.id }}" class="nlo-section" data-track-section="newsletter_offer">
  <div class="nlo-bar">
    {%- if section.settings.heading != blank -%}
      <p class="nlo-headline">
        {%- assign parts = section.settings.heading | split: '|' -%}
        {%- for part in parts -%}
          {%- if parts.size > 1 and forloop.index == 2 -%}<b>{{ part | strip }}</b>{%- else -%}{{ part | strip }}{%- endif -%}
          {%- unless forloop.last %} {% endunless -%}
        {%- endfor -%}
      </p>
    {%- endif -%}

    {%- form 'customer', id: 'nlo-form-' | append: section.id, class: 'nlo-form' -%}
      <input type="hidden" name="contact[tags]" value="newsletter,offer-5off">
      {%- if form.posted_successfully? -%}
        <p class="nlo-success">{{ section.settings.success_text }}{%- if section.settings.discount_code != blank %} <b>{{ section.settings.discount_code }}</b>{% endif -%}</p>
      {%- else -%}
        <input
          type="email"
          name="contact[email]"
          class="nlo-input"
          placeholder="{{ section.settings.input_placeholder }}"
          aria-label="{{ section.settings.input_placeholder }}"
          autocorrect="off"
          autocapitalize="off"
          required
        >
        <button type="submit" class="nlo-btn">{{ section.settings.button_label }}</button>
        {%- if form.errors -%}
          <small class="nlo-error">{{ form.errors.translated_fields['email'] | capitalize }} {{ form.errors.messages['email'] }}</small>
        {%- endif -%}
      {%- endif -%}
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "Newsletter Offer",
  "tag": "section",
  "class": "section-newsletter-offer",
  "settings": [
    { "type": "text", "id": "heading", "label": "Headline (use | before the part to highlight)", "default": "Get | 5% OFF your first order" },
    { "type": "text", "id": "input_placeholder", "label": "Email placeholder", "default": "Enter your email" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "GET CODE" },
    { "type": "header", "content": "Reward shown after signup" },
    { "type": "text", "id": "success_text", "label": "Success message", "default": "You're in! Use code" },
    { "type": "text", "id": "discount_code", "label": "Discount code", "default": "WELCOME5", "info": "Create this code in Shopify Admin → Discounts (e.g. WELCOME5 = 5% off)." },
    { "type": "header", "content": "Colours" },
    { "type": "color", "id": "bg_top", "label": "Background start", "default": "#fff0f6" },
    { "type": "color", "id": "bg_bottom", "label": "Background end", "default": "#eaf2ff" },
    { "type": "color", "id": "headline_color", "label": "Headline colour", "default": "#d6336c" },
    { "type": "color", "id": "accent_color", "label": "Accent colour", "default": "#ff5c8a" },
    { "type": "color", "id": "accent_text_color", "label": "Button text colour", "default": "#ffffff" },
    { "type": "color", "id": "input_text_color", "label": "Input text colour", "default": "#5a4a5e" },
    { "type": "color", "id": "input_border", "label": "Input border", "default": "#e3d9e4" },
    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "max_width", "min": 700, "max": 1400, "step": 20, "unit": "px", "label": "Max width", "default": 1000 },
    { "type": "range", "id": "padding_top", "min": 0, "max": 80, "step": 2, "unit": "px", "label": "Padding top", "default": 22 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 80, "step": 2, "unit": "px", "label": "Padding bottom", "default": 22 }
  ],
  "presets": [
    { "name": "Newsletter Offer" }
  ]
}
{% endschema %}
