{% comment %}  section setting css {% endcomment %}

{% style %}
    #shopify-section-{{ section.id }}.shopify-section {
        width: 100%;
        {% if section.settings.section_width_type == 'custom' %}
            max-width: {{ section.settings.section_width }}%;
        {% endif %}
        margin: 0 auto;
        display: block;
        background-color: {{ section.settings.section_bg }};
    }

    #shopify-section-{{ section.id }} #carousel-{{ section.id }} {
        padding: {{ section.settings.slider_padding_vertical_desktop }}px 0px;
    }


    #prevBtn-{{ section.id }}, #nextBtn-{{ section.id }} {
            height: {{ section.settings.arrow_size_desktop }}px;
            width: {{ section.settings.arrow_size_desktop }}px;
        }


        #shopify-section-{{ section.id }} .meet-bg-slide-btn {
            background-color: {{ section.settings.arrow_bg }};
            border-color: {{ section.settings.arrow_icon_color }};
        }

        #shopify-section-{{ section.id }} .meet-bg-slide-btn:hover {
            background-color: {{ section.settings.arrow_bg_hover }};
            border-color: {{ section.settings.arrow_icon_hover }};
        }

            #shopify-section-{{ section.id }} .meet-bg-slide-btn-svg {
                color: {{ section.settings.arrow_icon_color }};
            }


        #shopify-section-{{ section.id }} .meet-bg-slide-btn-svg:hover {
                color: {{ section.settings.arrow_icon_hover }};
            }

            #shopify-section-{{ section.id }} .meet-discount{
            {% if section.settings.show_discount == false %}
            display:none;
            {% endif %}
            color:{{ section.settings.discount_text_color }};
            background-color:{{ section.settings.discount_bg_color }};
            }


            #shopify-section-{{ section.id }} .meeet-like-btn{
                {% if section.settings.show_like == false %}
            display:none;
            {% endif %}
            }


            #shopify-section-{{ section.id }} .meeet-share-btn{
                {% if section.settings.show_share == false %}
            display:none;
            {% endif %}
            }

            #shopify-section-{{ section.id }} .meet-whatch-and-buy-card{
              background-color:{{ section.settings.card_bg }};
            }

            #shopify-section-{{ section.id }} .meet-product-title{
              color:{{ section.settings.title_color }};
            }

            #shopify-section-{{ section.id }} .meet-product-price{
              color:{{ section.settings.price_color }};
            }

            #shopify-section-{{ section.id }} .meet-product-discount{
              color:{{ section.settings.off_color }};
            }

            #shopify-section-{{ section.id }} .meet-product-button{
              background-color:{{ section.settings.btn_bg }};
              color:{{ section.settings.btn_text }};
              border-color:{{ section.settings.btn_border }};
            }

            #shopify-section-{{ section.id }} .meet-product-button:hover{
              background-color:{{ section.settings.btn_bg_hover }};
              color:{{ section.settings.btn_text_hover }};
              border-color:{{ section.settings.btn_border_hover }};
            }


    @media (max-width: 767px) {
        #shopify-section-{{ section.id }} #carousel-{{ section.id }} {
            padding:{{ section.settings.slider_padding_vertical_mobile }}px 0px;
        }
        #prevBtn-{{ section.id }}, #nextBtn-{{ section.id }} {
            height: {{ section.settings.arrow_size_mobile }}px;
            width: {{ section.settings.arrow_size_mobile }}px;
        }
    }

    #shopify-section-{{ section.id }} .meet-items-center-views {
      display: none;
    }

    /* class add product image 483 line */
    #shopify-section-{{ section.id }} .meet-product-image-round {
      border-radius: 100px;
      box-shadow: rgba(0, 0, 0, 0.25) 0px 54px 55px, rgba(0, 0, 0, 0.12) 0px -12px 30px, rgba(0, 0, 0, 0.12) 0px 4px 6px, rgba(0, 0, 0, 0.17) 0px 12px 13px, rgba(0, 0, 0, 0.09) 0px -3px 5px;
    }

    #shopify-section-{{ section.id }} .meet-product-title {
      margin: 0px;
      font-weight: normal;
    }
    #shopify-section-{{ section.id }} .meet-product-price p {
      margin: 0px;
      font-size: 13.5px;
    }
    #shopify-section-{{ section.id }} .meet-product-discount {
      margin-top: 5px;
      margin-bottom: 0px;
      font-weight: normal;
    }
    #shopify-section-{{ section.id }} .hover\:-meet-translate-y-1:hover {
      scale: 1.02
    }
    #shopify-section-{{ section.id }} .meet-product-button {
      width: 100%;
      display: block;
      text-align: center;
      text-decoration: none;
    }
    #shopify-section-{{ section.id }} .meeet-share-btn {
      margin-top: -5px;
    }
    @media screen and (min-width: 768px) and (max-width: 1500px) {
      #shopify-section-{{ section.id }}.shopify-section {
        min-width: 95%;
      }
      #shopify-{{ section.id }} .md\:meet-p-8 {
        padding: 2rem 0rem;
      }
    }
    .prevBtn-{{ section.id }},
    .nextBtn-{{ section.id }} {
      border-radius: 100px;
      border: none;
      opacity: 0.8;
    }

     /* instagran reel */

      .HoverCard {
      display: none;
  }

     /*   #shopify-section-{{ section.id }} .hover\:meet-text-red-500:hover
      #shopify-section-{{ section.id }} .hover\:meet-text-sky-400:hover */
{% endstyle %}
<div class="meet-w-full meet-mx-auto meet-p-4 md:meet-p-8">
  <div class="meet-text-3xl meet-font-bold meet-text-gray-800 meet-mb-2 meet-text-center">
    {{ section.settings.title }}
  </div>
  <div class="meet-text-gray-600 meet-mb-8 meet-text-center">{{ section.settings.subtitle }}</div>

  <div class="meet-relative">
    <div
      id="carousel-{{ section.id }}"
      class="meet-flex meet-overflow-x-auto meet-space-x-4  meet-no-scrollbar meet-scroll-smooth"
    >
      <div class="swiper-wrapper" id="swiper-wrapper-{{ section.id }}">
        {% for block in section.blocks %}
          {% assign product = block.settings.product %}
          {% assign compare_price = product.variants.first.compare_at_price %}
          {% assign current_price = product.variants.first.price %}

          {% if compare_price > current_price and compare_price > 0 %}
            {% assign discount = compare_price | minus: current_price %}
            {% assign discount_percentage = discount | times: 100 | divided_by: compare_price %}
          {% else %}
            {% assign discount_percentage = 0 %}
          {% endif %}

          {% if block.settings.video_source == 'youtube' %}
            {% assign video_url = block.settings.youtube_url %}
            {% assign video_type = 'youtube' %}
          {% elsif block.settings.video_source == 'instagram' %}
            {% assign video_url = block.settings.instagram_code %}
            {% assign video_type = 'instagram' %}
          {% elsif block.settings.video_source == 'shopify' %}
            {% assign video_url = block.settings.video %}
            {% assign video_type = 'shopify' %}
          {% endif %}
          <div
            class="swiper-slide meet-whatch-and-buy-card meet-flex-none meet-w-72 meet-bg-white meet-rounded-xl meet-shadow-lg meet-overflow-hidden meet-transform hover:-meet-translate-y-1 meet-transition-all meet-duration-300 swiper-slide-active"
            style="width: 300.667px; margin-right: 20px;"
            role="group"
            aria-label="1 / 6"
            data-swiper-slide-index="0"
          >
            <div class="meet-relative ">
              {% if block.settings.video_source == 'youtube' %}
                {% if video_url != blank %}
                  <div class="meet-video-container">
                    <div class="meet-video-player">
                      <iframe
                        class="meet-w-full meet-portrait  meet-object-cover pointer-events-none"
                        src="{{ video_url | replace : 'shorts' , 'embed'}}?autoplay=1&amp;mute=1&amp;loop=1&amp;playlist=sKrjCJPfIC8&amp;controls=0&amp;playsinline=1&amp;enablejsapi=1"
                        frameborder="0"
                        allow="autoplay; encrypted-media"
                        allowfullscreen=""
                        data-gtm-yt-inspected-15="true"
                        id="312187324"
                        title="Leopard 2A6 main battle tank RC model"
                      ></iframe>
                      <div class="meet-absolute meet-top-0 meet-left-0 meet-w-full  meet-video-overlay-gradient"></div>
                      {% if discount_percentage != blank %}
                        <div class="meet-discount meet-absolute meet-top-3 meet-left-3 meet-bg-black meet-text-white meet-text-xs meet-font-semibold meet-px-3 meet-py-1 meet-rounded-full">
                          {{ discount_percentage }}% discount
                        </div>
                      {% endif %}
                    </div>
                  </div>
                  <div class="meet-absolute meet-bottom-3 meet-right-3 meet-flex  meet-items-center meet-space-y-3">
                    {% if block.settings.show_like %}
                      <a
                        href="{{ block.settings.like_url }}"
                        class="meeet-like-btn meet-background-transparent meet-text-white hover:meet-text-red-500 meet-transition-colors meet-duration-300"
                      >
                        <svg
                          xmlns="http://www.w3.org/2000/svg"
                          class="meet-h-6 meet-w-6"
                          fill="none"
                          viewBox="0 0 24 24"
                          stroke="currentColor"
                          stroke-width="2"
                        >
                          <path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 016.364 0L12 7.636l1.318-1.318a4.5 4.5 0 116.364 6.364L12 20.364l-7.682-7.682a4.5 4.5 0 010-6.364z"></path>
                        </svg>
                      </a>
                    {% endif %}
                    {% if block.settings.show_share %}
                      <a
                        href="{{ block.settings.share_url }}"
                        class="meeet-share-btn meet-background-transparent  meet-text-white hover:meet-text-sky-400 meet-transition-colors meet-duration-300"
                      >
                        <svg
                          xmlns="http://www.w3.org/2000/svg"
                          class="meet-h-6 meet-w-6 -meet-rotate-12"
                          fill="none"
                          viewBox="0 0 24 24"
                          stroke="currentColor"
                          stroke-width="1.5"
                        >
                          <path stroke-linecap="round" stroke-linejoin="round" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"></path>
                        </svg>
                      </a>
                    {% endif %}
                  </div>
                {% else %}
                  {{ 'image' | placeholder_svg_tag }}
                {% endif %}
              {% elsif block.settings.video_source == 'shopify' %}
                {% if video_url != blank %}
                  <div class="meet-video-container">
                    <div class="meet-video-player">
                      {{
                        video_url
                        | video_tag:
                          autoplay: true,
                          loop: true,
                          muted: true,
                          controls: false,
                          height: '100%',
                          width: '100%',
                          class: 'my-video-class'
                      }}
                      <div class="meet-absolute meet-top-0 meet-left-0 meet-w-full  meet-video-overlay-gradient"></div>
                      {% if discount_percentage != blank %}
                        <div class="meet-discount meet-absolute meet-top-3 meet-left-3 meet-bg-black meet-text-white meet-text-xs meet-font-semibold meet-px-3 meet-py-1 meet-rounded-full">
                          {{ discount_percentage }}% discount
                        </div>
                      {% endif %}
                    </div>
                  </div>
                  <div class="meet-absolute meet-bottom-3 meet-right-3 meet-flex  meet-items-center meet-space-y-3">
                    {% if block.settings.show_like %}
                      <a
                        href="{{ block.settings.like_url }}"
                        class="meeet-like-btn meet-background-transparent meet-text-white hover:meet-text-red-500 meet-transition-colors meet-duration-300"
                      >
                        <svg
                          xmlns="http://www.w3.org/2000/svg"
                          class="meet-h-6 meet-w-6"
                          fill="none"
                          viewBox="0 0 24 24"
                          stroke="currentColor"
                          stroke-width="2"
                        >
                          <path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 016.364 0L12 7.636l1.318-1.318a4.5 4.5 0 116.364 6.364L12 20.364l-7.682-7.682a4.5 4.5 0 010-6.364z"></path>
                        </svg>
                      </a>
                    {% endif %}
                    {% if block.settings.show_share %}
                      <a
                        href="{{ block.settings.share_url }}"
                        class="meeet-share-btn meet-background-transparent  meet-text-white hover:meet-text-sky-400 meet-transition-colors meet-duration-300"
                      >
                        <svg
                          xmlns="http://www.w3.org/2000/svg"
                          class="meet-h-6 meet-w-6 -meet-rotate-12"
                          fill="none"
                          viewBox="0 0 24 24"
                          stroke="currentColor"
                          stroke-width="1.5"
                        >
                          <path stroke-linecap="round" stroke-linejoin="round" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"></path>
                        </svg>
                      </a>
                    {% endif %}
                  </div>

                {% else %}
                  {{ 'image' | placeholder_svg_tag }}
                {% endif %}

              {% elsif block.settings.video_source == 'instagram' %}
                {% if video_url != blank %}
                  {{ video_url }}
                  {% comment %} <p class="meet-product-discount meet-text-xs meet-font-semibold meet-text-green-600">{% if discount_percentage != blank %}{{ discount_percentage }} {% endif %}%Off</p>{% endcomment %}
                {% else %}
                  {{ 'image' | placeholder_svg_tag }}
                {% endif %}
              {% endif %}
            </div>
            <div class="meet-p-4">
              <div class="meet-flex meet-items-center meet-space-x-3">
                <img
                  src="{% if product.images.first.src != blank %}{{ product.images.first.src | image_url }}{% else %} https://cdn.shopify.com/s/files/1/0533/2089/files/placeholder-images-image_large.png?v=1530129081 {% endif %}"
                  alt="{{ product.title}}"
                  class="meet-w-14 meet-h-12  meet-rounded-full meet-object-cover meet-border-2 meet-border-gray-100 meet-product-image-round"
                >
                <div>
                  <h3 class="meet-product-title meet-font-semibold meet-text-gray-800 meet-text-xl meet-truncate meet-w-100">
                    {% if product.title != blank %}{{ product.title | escape }}{% else %} Product Name {% endif %}
                  </h3>
                  <div class="meet-product-price meet-flex meet-items-baseline meet-space-x-1.5 meet-mt-1">
                    <p class="meet-font-bold meet-text-gray-900">
                      {% if current_price != blank -%}
                        {{- current_price | money_with_currency -}}
                      {%- else %}
                        {{ '99' | money_with_currency }}
                      {% endif %}
                    </p>
                    <p class="meet-text-xs meet-text-gray-400 meet-line-through">
                      {% if compare_price != blank -%}
                        {{- compare_price | money_with_currency -}}
                      {%- else -%}
                        {{- '999' | money_with_currency }}
                      {% endif %}
                    </p>
                  </div>
                  <p class="meet-product-discount meet-text-xl  meet-font-semibold meet-text-green-600">
                    {% if discount_percentage != blank %}{{ discount_percentage }} {% endif %}%Off
                  </p>
                </div>
              </div>
              <a
                href="{{ product.url }}"
                class="meet-product-button meet-mt-3 meet-w-full meet-bg-gray-900 meet-text-white meet-py-4 meet-rounded-lg meet-font-semibold meet-text-xl hover:meet-bg-gray-800 meet-transition-colors meet-duration-300"
                >Buy Now</a
              >
            </div>
          </div>
        {% endfor %}
      </div>
    </div>

    <button
      id="prevBtn-{{ section.id }}"
      class="prevBtn-{{ section.id }} meet-absolute meet-top-1/2 meet-left-2 meet-transform meet-translate-y-1/2 meet-bg-slide-btn meet-backdrop-blur-sm meet-p-2 meet-text-gray-800 meet-shadow-lg hover:meet-bg-white meet-transition meet-duration-300 meet-z-10"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="meet-bg-slide-btn-svg"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
      >
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
      </svg>
    </button>
    <button
      id="nextBtn-{{ section.id }}"
      class="nextBtn-{{ section.id }} meet-absolute meet-top-1/2 meet-right-2 meet-transform -meet-translate-y-1/2 meet-bg-slide-btn meet-backdrop-blur-sm meet-p-2 meet-text-gray-800 meet-shadow-lg hover:meet-bg-white meet-transition meet-duration-300 meet-z-10"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="meet-bg-slide-btn-svg"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
      >
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
      </svg>
    </button>
  </div>
</div>
<!-- Swiper JS -->
<script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
<script>
  const swiper = new Swiper("#carousel-{{ section.id }}", {
        slidesPerView: {{ section.settings.slides_desktop }},   // 👈 shows 4 slides
        spaceBetween: 20,   // space between slides
        loop: true,
        pagination: {
          el: ".swiper-pagination",
          clickable: true,
        },
        navigation: {
          prevEl: "#prevBtn-{{ section.id }}",
          nextEl: "#nextBtn-{{ section.id }}",
        },
        breakpoints: {
          0: {  // mobile
            slidesPerView: 1,
          },
          480: {        // mobile
            slidesPerView: 1,
          },
          867: {      // small tablets
              slidesPerView: 2,
          },
          1250: {     // small tablets
              slidesPerView: 3,
          },
          1600: {      // small tablets
            slidesPerView: 3.5,
          },
          1700: {      // small tablets
            slidesPerView: 4,
          }
        }
      });
</script>

