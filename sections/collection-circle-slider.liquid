{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}
<section class="collection-circle-slider section-{{ section.id }}-padding">
  <div class="page-width">
    <div class="collection-slider">
       {% for block in section.blocks %}
        {% if block.settings.link_collection != blank %}
          <a
            href="{{ block.settings.link_collection.url }}"
            class="collection-item"
            {{ block.shopify_attributes }}
          >

            <div class="collection-image">
              {% if block.settings.image %}
                <img
                  src="{{ block.settings.image | image_url: width: 300 }}"
                  alt="{{ block.settings.title | escape }}"
                  loading="lazy"
                >
              {% endif %}
            </div>

            {% if block.settings.title != blank %}
              <p class="collection-title">
                {{ block.settings.title }}
              </p>
            {% endif %}

          </a>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Collection Circle Slider",
  "settings": [
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
 "blocks": [
    {
      "type": "item",
      "name": "Collection Item",
      "settings": [
        {
          "type": "collection",
          "id": "link_collection",
          "label": "Collection link"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Upload image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        }
        
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Collection Circle Slider"
    }
  ]
}
{% endschema %}
<style>
{% comment %} .collection-circle-slider {
  padding: 30px 0;
} {% endcomment %}

.collection-slider {
  display: flex;
  gap: 32px;
  overflow-x: auto;
  scroll-snap-type: x mandatory;
  padding-bottom: 10px;
}

.collection-slider::-webkit-scrollbar {
  display: none;
}

.collection-item {
  flex: 0 0 auto;
  text-align: center;
  scroll-snap-align: start;
  text-decoration: none;
  color: inherit;
  transition: transform 0.25s ease, color 0.25s ease;
}

.collection-image {
  width: 140px;
  height: 140px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 12px;
  transition: transform 0.25s ease, box-shadow 0.25s ease;
}

.collection-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
    border-radius: 100%;
}

.collection-title {
  font-weight: 600;
  font-size: 16px;
}

/* Hover effect */
.collection-item:hover .collection-image {
  transform: scale(1.06);
  box-shadow: 0 10px 18px rgba(0, 0, 0, 0.18);
}

.collection-item:hover .collection-title {
  color: rgb(var(--color-button));
}

/* Mobile */
@media (max-width: 768px) {
  .collection-image {
    width: 110px;
    height: 110px;
  }

  .collection-title {
    font-size: 14px;
  }
}

    </style>